---
import Site from '../layouts/Site.astro';
import { getGems, url } from '../lib/gems';
const all = await getGems();
const repo = import.meta.env.PUBLIC_REPO || 'showtimestudiosinc/imperious-wiki';
const sections = [
  { href: '/gem-types/', title: 'Gem-Types', text: `Every type in the empire, from Servants to Transcendents. ${all.length} catalogued.`, glyph: '◈' },
  { href: '/start-here/welcome/', title: 'Start Here', text: 'New to the server? What the setting is, and how to build your first Gem.', glyph: '⟡' },
  { href: '/rules/overview/', title: 'Rules', text: 'Battles, stats, abilities, items, SKILLs, and statuses.', glyph: '〣' },
  { href: '/lore/overview/', title: 'Lore', text: 'The Diamonds, the United Frontier, Nuggets of Lore, and more.', glyph: '✧' },
];
---
<Site title="Imperious Authorities">
  <main class="wrap home">
    <header class="hero">
      <p class="eyebrow">⟡ The Imperious Authorities Wiki ⟡</p>
      <h1>Imperious Authorities</h1>
      <p class="tag">The rulebook and the setting, in one place.</p>
    </header>
    <div class="layout">
      <div class="sections">
        {sections.map((s) => (
          <a class="panel section" href={url(s.href)}>
            <span class="glyph">{s.glyph}</span>
            <span><strong>{s.title}</strong><br /><small>{s.text}</small></span>
          </a>
        ))}
      </div>
      <aside class="panel log">
        <div class="bar">Latest Changes</div>
        <ol id="log" class="body"><li class="muted">Loading the latest changes…</li></ol>
        <a class="all-changes" href={`https://github.com/${repo}/commits/main`} target="_blank" rel="noopener">Full history on GitHub</a>
      </aside>
    </div>
  </main>
</Site>
<script define:vars={{ repo }}>
  // Reads commits straight from GitHub, so a fresh edit shows up before the site finishes rebuilding.
  const log = document.getElementById('log');
  const ago = (d) => { const m = Math.round((Date.now() - d) / 60000); return m < 60 ? `${m}m ago` : m < 1440 ? `${Math.round(m / 60)}h ago` : `${Math.round(m / 1440)}d ago`; };
  fetch(`https://api.github.com/repos/${repo}/commits?per_page=12`)
    .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
    .then((cs) => {
      log.innerHTML = cs.map((c) => {
        const msg = c.commit.message.split('\n')[0].replace(/</g, '&lt;');
        return `<li><span>${msg}</span><small>${ago(new Date(c.commit.author.date))}</small></li>`;
      }).join('') || '<li class="muted">No changes yet.</li>';
    })
    .catch(() => { log.innerHTML = '<li class="muted">The change log will show here once the site is on GitHub.</li>'; });
</script>
<style>
  .hero { text-align: center; padding: 3rem 0 2rem; }
  .eyebrow { color: var(--lav-2); letter-spacing: 0.3em; font-size: 0.75rem; text-transform: uppercase; }
  .hero h1 { font-size: clamp(2rem, 6vw, 3.6rem); margin: 0.3rem 0; letter-spacing: 0.12em; text-transform: uppercase; }
  .tag { color: var(--muted); }
  .layout { display: grid; grid-template-columns: 1.5fr 1fr; gap: 1rem; }
  .sections { display: grid; gap: 0.8rem; }
  .section { display: flex; gap: 1rem; align-items: center; padding: 1.1rem 1.2rem; color: var(--text); }
  .section:hover { border-color: var(--line-strong); color: #fff; }
  .section strong { font-family: var(--serif); font-weight: 400; font-size: 1.2rem; letter-spacing: 0.05em; }
  .section small { color: var(--muted); }
  .glyph { font-size: 1.6rem; color: var(--lav); width: 2rem; text-align: center; }
  .log ol { list-style: none; margin: 0; }
  .log li { display: flex; justify-content: space-between; gap: 0.8rem; padding: 0.35rem 0; border-bottom: 1px solid rgba(201, 184, 255, 0.1); font-size: 0.86rem; }
  .log small { color: var(--muted); white-space: nowrap; }
  .muted { color: var(--muted); }
  .all-changes { display: block; padding: 0.6rem 1rem; font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; }
  @media (max-width: 820px) { .layout { grid-template-columns: 1fr; } }
</style>
