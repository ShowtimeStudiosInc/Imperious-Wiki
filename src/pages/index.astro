---
import Site from '../layouts/Site.astro';
import { getGems, url } from '../lib/gems';
import HoloScreen from '../components/HoloScreen.astro';
const all = await getGems();
const repo = import.meta.env.PUBLIC_REPO || 'ShowtimeStudiosInc/Imperious-Wiki';
const sections = [
  { href: '/gem-types/', title: 'Gem-Types', text: `Every type in the empire, from Servants to Transcendents. ${all.length} catalogued.`, glyph: '◈' },
  { href: '/start-here/welcome/', title: 'Start Here', text: 'New to the server? What the setting is, and how to build your first Gem.', glyph: '⟡' },
  { href: '/rules/overview/', title: 'Rules', text: 'Battles, stats, abilities, items, SKILLs, and statuses.', glyph: '〣' },
  { href: '/lore/overview/', title: 'Lore', text: 'The Diamonds, the United Frontier, Nuggets of Lore, and more.', glyph: '✧' },
];
---
<Site title="Imperious Authorities">
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;600;700&display=swap" />
  <main class="wrap home">
    <header class="hero">
      <img class="hero-logo" src={url('/images/brand/logo-white.png')} alt="Imperious Authorities logo" width="134" height="162" />
      <p class="eyebrow">⟡ The Imperious Authorities Wiki ⟡</p>
      <h1>Imperious Authorities</h1>
    </header>
    <div class="layout">
      <div class="sections">
        {sections.map((s) => (
          <a class="panel section" href={url(s.href)}>
            <span class="glyph">{s.glyph}</span>
            <span><strong>{s.title}</strong><br /><small>{s.text}</small></span>
          </a>
        ))}
      </div>
      <div class="side">
      <HoloScreen />
      <aside class="panel log">
        <div class="bar">Latest Changes</div>
        <ol id="log" class="body"><li class="muted">Loading the latest changes…</li></ol>
      </aside>
      </div>
    </div>
  </main>
</Site>
<script define:vars={{ repo }}>
  // Reads the update log from the commit history, so a fresh edit shows up before the site finishes rebuilding.
  // Only lines in the update format that point at a page on this site are shown:
  //   <Content> was updated at [<Place>](<link to this site>)
  const log = document.getElementById('log');
  const home = new URL('.', location.href).href;
  const LINE = /^(.+? (?:was|were) (?:updated|added) at) \[([^\]]+)\]\((https?:\/\/[^)\s]+)\)\s*$/;
  const esc = (t) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const ago = (d) => { const m = Math.max(0, Math.round((Date.now() - d) / 60000)); return m < 60 ? `${m}m ago` : m < 1440 ? `${Math.round(m / 60)}h ago` : `${Math.round(m / 1440)}d ago`; };
  const onSite = (u) => { try { const x = new URL(u); return x.origin === location.origin && x.pathname.startsWith(new URL(home).pathname); } catch { return false; } };
  fetch(`https://api.github.com/repos/${repo}/commits?per_page=60`)
    .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
    .then((cs) => {
      const items = [];
      const seen = new Set();
      for (const c of cs) {
        const when = new Date(c.commit.author.date);
        for (const raw of c.commit.message.split('\n')) {
          const text = raw.trim().replace(/^[-*]\s+/, '');
          const m = text.match(LINE);
          if (!m || !onSite(m[3]) || seen.has(text)) continue;
          seen.add(text);
          const link = new URL(m[3]);
          items.push(`<li><span>${esc(m[1])} <a href="${esc(link.pathname + link.hash)}">${esc(m[2])}</a></span><small>${ago(when)}</small></li>`);
        }
        if (items.length >= 10) break;
      }
      log.innerHTML = items.slice(0, 10).join('') || '<li class="muted">Updates will show here as pages change.</li>';
    })
    .catch(() => { log.innerHTML = '<li class="muted">Updates will show here as pages change.</li>'; });
</script>
<style>
  .hero { text-align: center; padding: 3rem 0 2rem; }
  .hero-logo { display: block; margin: 0 auto 1rem; height: clamp(90px, 16vw, 150px); width: auto; filter: drop-shadow(0 0 18px var(--glow, rgba(124, 77, 255, 0.45))); }
  .eyebrow { color: var(--lav-2); letter-spacing: 0.3em; font-size: 0.75rem; text-transform: uppercase; }
  .hero h1 { font-size: clamp(2rem, 6vw, 3.6rem); margin: 0.3rem 0; letter-spacing: 0.12em; text-transform: uppercase; }
  .tag { color: var(--muted); }
  .layout { display: grid; grid-template-columns: 1.5fr 1fr; gap: 1rem; }
  .sections { display: grid; gap: 0.8rem; }
  .section { display: flex; gap: 1rem; align-items: center; padding: 1.1rem 1.2rem; color: var(--text); }
  .section:hover { border-color: var(--line-strong); color: #fff; }
  .section strong { font-family: var(--serif); font-weight: 400; font-size: 1.2rem; letter-spacing: 0.05em; }
  .section small { color: var(--muted); }
  .glyph { font-size: 1.6rem; color: var(--lav); width: 2rem; text-align: center; }
  .log ol { list-style: none; margin: 0; }
  .log :global(li) { display: block; padding: 0.45rem 0; border-bottom: 1px solid rgba(201, 184, 255, 0.1); font-size: 0.86rem; }
  .log :global(a) { color: var(--lav-2); }
  .log :global(small) { display: block; margin-top: 0.15rem; color: var(--muted); font-size: 0.75rem; }
  :global(.muted) { color: var(--muted); }
  @media (max-width: 820px) { .layout { grid-template-columns: 1fr; } }
</style>
