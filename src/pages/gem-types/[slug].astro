---
import Site from '../../layouts/Site.astro';
import GemIcon from '../../components/GemIcon.astro';
import { getGems, tagsFor, fullName, rich, resolveSlug, url, RANKS, characterTemplate, type Gem } from '../../lib/gems';

export async function getStaticPaths() {
  const all = await getGems();
  return all.map((g) => ({ params: { slug: g.slug }, props: { gem: g, all } }));
}
const { gem: g, all } = Astro.props as { gem: Gem; all: Gem[] };
const tags = tagsFor(g, all);
const rank = g.rank ? RANKS[g.rank] : null;
const s = g.stats;
const statTotal = s ? s.atk + s.def + s.spd + s.int + s.mag : null;
const hpCeiling = s ? 20 + s.def * 2 : null;

// Abilities grouped in the order they appear on a profile.
const ORDER = ['Signature Ability', 'ACT Bonus', 'Fusion Ability', 'Latent Ability'];
const sections = [...new Set(g.abilities.map((a) => a.section))].sort((a, b) => {
  const ia = ORDER.indexOf(a), ib = ORDER.indexOf(b);
  return (ia < 0 ? 0.5 : ia) - (ib < 0 ? 0.5 : ib);
});

// Discord spell format pieces, for the copy-ready sheet text on active abilities.
const SPELL_EMOJI = '<:Spell:1568035570641412217>';
const CATS: Record<string, string> = {
  offensive: '<:offensive:1545460315938885682>',
  defensive: '<:defensive:1545460376819212298>',
  debuff: '<:debuff:1545460459854102628>',
  utility: '<:utility:1545600013063692308>',
  buff: '<:buff:1545460423250415726>',
  mobility: '<:mobility:1545460499355803688>',
  summoning: '<:summoning:1545467552854056980>',
  elements: '<:elements:1545467786501947462>',
};
// The Discord-format text a member copies from an ability card. Active
// abilities copy as spell blocks, one per move, or the ability itself when it
// has no moves; a latent with moves puts its own line first, the way a sheet
// writes it. Passives and anything else without a cost copies as a single
// sheet line. Empty only when the ability has no name, so those cards get no
// copy button.
const sheetText = (a: Gem['abilities'][number]): string => {
  if (!a.name) return '';
  const units = a.moves.length > 0 ? a.moves : [a];
  const spells = units
    .filter((u) => u.cost != null && CATS[(u.category ?? a.category) ?? ''])
    .map((u) => [`## ${SPELL_EMOJI} *${u.name}*`, `> ${CATS[(u.category ?? a.category) as string]}  ${u.text}`, '`Costs ' + u.cost + ' SP.`'].join('\n'));
  if (spells.length > 0) {
    if (a.section === 'Latent Ability' && a.moves.length > 0) {
      return [`\`${a.name}\` - ${a.text}`, ...spells].join('\n\n');
    }
    return spells.join('\n\n');
  }
  if ((a.tags ?? []).includes('PASSIVE')) return `\`${a.name} [PASSIVE]\` - ${a.text}`;
  return `\`${a.name}\` - ${a.text}`;
};

// Related: parent, sub-types, fusions it's part of, same-name variants, fusion halves.
const parent = g.kind === 'sub-type' ? resolveSlug(all, g.parent) : null;
const children = all.filter((x) => x.kind === 'sub-type' && resolveSlug(all, x.parent)?.slug === g.slug);
const partOf = all.filter((x) => x.components?.some((c) => c === g.slug || resolveSlug(all, c)?.slug === g.slug));
const halves = (g.components ?? []).map((c) => resolveSlug(all, c) ?? { name: c, slug: null });
const siblings = all.filter((x) => x.slug !== g.slug && x.name === g.name);
const shiftFrom = g.shiftOf ? resolveSlug(all, g.shiftOf) : null;
const shifts = all.filter((x) => x.shiftOf === g.slug);
const ancestor = g.descendedFrom ? resolveSlug(all, g.descendedFrom) : null;
const descendants = all.filter((x) => x.descendedFrom === g.slug);
const related = [
  ...(shiftFrom ? [{ label: 'Shifts from', items: [shiftFrom] }] : []),
  ...(shifts.length ? [{ label: 'Prism shifts', items: shifts }] : []),
  ...(ancestor ? [{ label: 'Descended from', items: [ancestor] }] : []),
  ...(descendants.length ? [{ label: 'Descendants', items: descendants }] : []),
  ...(parent ? [{ label: 'Parent type', items: [parent] }] : []),
  ...(halves.length ? [{ label: 'Fusion of', items: halves }] : []),
  ...(children.length ? [{ label: 'Sub-types', items: children }] : []),
  ...(partOf.length ? [{ label: 'Fuses into', items: partOf }] : []),
  ...(siblings.length ? [{ label: 'Other versions', items: siblings }] : []),
];
const attached = (g.attachments ?? []).map((a) => resolveSlug(all, a)).filter(Boolean) as Gem[];
const builder = url(`/gem-builder/?type=${encodeURIComponent(g.slug)}`);
const desc = g.role.split('. ').slice(0, 2).join('. ').slice(0, 200);
---
<Site title={fullName(g)} description={desc} current="gem-types">
  <main class="wrap codex" data-pagefind-body data-pagefind-meta="section:Gem-Types">
    <p class="crumbs" data-pagefind-ignore><a href={url('/gem-types/')}>Gem-Types</a> <span>/</span> {rank && g.faction !== 'lost' ? <span>Rank {g.rank} · {rank.name}</span> : <span>{g.faction === 'lost' ? 'Discontinued Types' : g.faction === 'united-frontier' ? 'United Frontier' : g.faction === 'rogue' ? 'Rogues' : ''}</span>}</p>

    <section class="panel namebar">
      <div class="bar">&nbsp;</div>
      <div class="body nameline">
        <h1>{g.name}{g.variant && <span class="variant"> {g.variant} Variant</span>}</h1>
        <div class="chips">
          {tags.map((t) => <a class="chip" href={t.href} data-group={t.group} data-tone={t.tone}>{t.label}</a>)}
        </div>
      </div>
    </section>

    <div class="cols">
      <div class="col">
        <section class="panel banner" data-faction={g.faction}>
          {g.image ? (
            <img class="banner-img" src={g.image.startsWith('/') ? url(g.image) : g.image} alt={`${fullName(g)} art`} />
          ) : (
            <div class="art"><GemIcon name={g.name} fusion={g.kind === 'fusion'} gemstone={g.gemstone} size={170} /></div>
          )}
          {!g.image && <p class="art-note">{g.gemstone ? 'Gemstone shown until art is added.' : 'No art yet.'}</p>}
        </section>

        <section class="panel">
          <div class="bar">Role</div>
          <div class="body prose"><p set:html={rich(g.role)} /></div>
        </section>

        <section class="panel">
          <div class="bar">Abilities</div>
          <div class="body abilities">
            {sections.map((sec) => (
              <div class={`ab-group ${sec === 'Latent Ability' ? 'latent' : ''}`}>
                <h3>{sec}{sec === 'Latent Ability' && <span class="hint"> · may unlock through story or training</span>}</h3>
                {g.abilities.filter((a) => a.section === sec).map((a) => (
                  <article class="spell">
                    {sheetText(a) && <button class="copybtn" type="button" data-copy={sheetText(a)}>⧉ Copy</button>}
                    {a.name && (
                      <header>
                        <span class="sname">{a.name}</span>
                        {a.tags.map((t) => <span class={`stag ${/SP$/.test(t) ? 'cost' : ''}`}>{t}</span>)}
                      </header>
                    )}
                    <p set:html={rich(a.text)} />
                    {a.moves.length > 0 && (
                      <ul class="moves">
                        {a.moves.map((m) => (
                          <li>
                            <span class="mname">{m.name}</span>
                            {m.tags.map((t) => <span class={`stag ${/SP$/.test(t) ? 'cost' : ''}`}>{t}</span>)}
                            <span set:html={' ' + rich(m.text)} />
                          </li>
                        ))}
                      </ul>
                    )}
                  </article>
                ))}
              </div>
            ))}
            {g.extraBlocks?.map((b) => (
              <div class="ab-group">
                <h3>{b.title}</h3>
                <ul class="table-list">{b.lines.map((l) => <li set:html={rich(l)} />)}</ul>
              </div>
            ))}
          </div>
        </section>
      </div>

      <div class="col">
        <section class="panel">
          <div class="bar">Description</div>
          <div class="body desc">
            {g.gemstone && <img class="stone" src={url(g.gemstone)} alt={`${fullName(g)} gemstone`} width="96" height="96" />}
            {g.description && <p set:html={rich(g.description)} />}
            <dl class="facts">
              <dt>Height</dt><dd>{g.height ?? 'Not set yet'}</dd>
              <dt>Rank</dt><dd>{rank ? `${g.rank} · ${rank.name}` : g.faction === 'united-frontier' ? 'United Frontier (no ranks)' : 'None'}</dd>
              {g.side && <><dt>Side</dt><dd>{g.side}</dd></>}
              {g.threatClass && <><dt>Threat Class</dt><dd>{g.threatClass}</dd></>}
            </dl>
          </div>
        </section>

        <section class="panel">
          <div class="bar">{g.modifiers ? 'Stat Modifiers' : 'Base Stats'}</div>
          <div class="body">
            {s ? (
              <>
                <div class="statgrid">
                  {(['hp', 'atk', 'def', 'spd', 'int', 'mag'] as const).map((k) => (
                    <div class="stat"><span class="k">{k.toUpperCase()}</span><span class="v">{s[k]}</span>
                      {k !== 'hp' && <span class="meter"><i style={`width:${Math.min(100, (s[k] / 12) * 100)}%`} /></span>}
                    </div>
                  ))}
                </div>
                <p class="statnote">
                  Stat points {statTotal}{rank?.budget ? ` of a ${rank.budget} budget, the rest pays for abilities` : ''}. HP ceiling {hpCeiling} (20 + DEF × 2).
                </p>
              </>
            ) : g.modifiers ? (
              <>
                <div class="statgrid">
                  {(['hp', 'atk', 'def', 'spd', 'int', 'mag'] as const).map((k) => {
                    const v = g.modifiers?.[k] ?? 0;
                    return <div class="stat"><span class="k">{k.toUpperCase()}</span><span class="v">{v > 0 ? `+${v}` : v}</span></div>;
                  })}
                </div>
                <p class="statnote">Stat modifiers. Add these to a Clear Quartz's base stats when her Prism shift settles on this type.</p>
              </>
            ) : <p class="muted">A fusion's stats come from its two halves. Add them together on the fusion's sheet.</p>}
          </div>
        </section>

        <section class="panel">
          <div class="bar">Interactions</div>
          <div class="body prose">{g.interactions ? <p set:html={rich(g.interactions)} /> : <p class="muted">Not written yet.</p>}</div>
        </section>

        {attached.length > 0 && (
          <section class="panel">
            <div class="bar">Attachments</div>
            <div class="body attach">
              {attached.map((x) => (
                <a class="att" href={url(`/gem-types/${x.slug}/`)}>
                  <GemIcon name={x.name} fusion={x.kind === 'fusion'} gemstone={x.gemstone} size={44} />
                  <span>{fullName(x)}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {related.length > 0 && (
          <section class="panel">
            <div class="bar">Related</div>
            <div class="body related">
              {related.map((r) => (
                <div><span class="rlabel">{r.label}</span>
                  <div class="chips">{r.items.map((x: any) => x.slug ? <a class="chip" href={url(`/gem-types/${x.slug}/`)}>{fullName(x)}</a> : <span class="chip">{x.name}</span>)}</div>
                </div>
              ))}
            </div>
          </section>
        )}

        {g.notes?.map((n) => <p class="note" set:html={rich(n)} />)}
      </div>
    </div>

    <footer class="panel codex-foot">
      <div class="body footrow">
        <button class="btn" type="button" data-copy={characterTemplate(g)}>⧉ Copy Character Template</button>
        <a class="btn" href={builder}>◈ Open in Submission Builder</a>
        <span class="credit">{g.credit ? `Design: ${g.credit}` : 'Design: Imperious Authorities staff'}{g.updated && ` · Last updated ${g.updated}`}</span>
      </div>
    </footer>
  </main>
</Site>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy || ''); const t = b.textContent; b.textContent = '✓ Copied'; setTimeout(() => (b.textContent = t), 1600); }
      catch { b.textContent = 'Copy failed'; }
    });
  });
</script>

<style>
  .crumbs { color: var(--muted); font-size: 0.8rem; letter-spacing: 0.06em; margin: 0 0 0.8rem; }
  .crumbs span { margin: 0 0.3rem; }
  .namebar .bar { padding: 0.35rem; }
  .nameline { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.2rem; }
  .nameline h1 { margin: 0; font-size: 1.9rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .variant { font-size: 0.9rem; color: var(--muted); letter-spacing: 0.06em; }
  .cols { display: grid; grid-template-columns: 1.15fr 1fr; gap: 0.9rem; margin-top: 0.9rem; }
  .col { display: flex; flex-direction: column; }
  .col .panel + .panel { margin-top: 0.9rem; }
  .banner { position: relative; min-height: 180px; display: grid; place-items: center; overflow: hidden;
    background: radial-gradient(circle at 50% 60%, rgba(124, 77, 255, 0.35), transparent 60%), linear-gradient(90deg, #2a1650, #160b2b 50%, #2a1650); }
  .banner[data-faction='lost'] { background: radial-gradient(circle at 50% 60%, rgba(255, 255, 255, 0.18), transparent 60%), #15121d; filter: saturate(0.6); }
  .banner-img { display: block; width: 100%; height: auto; max-height: 420px; object-fit: cover; }
  .banner:has(.banner-img) { min-height: 0; display: block; }
  .art { padding: 1.4rem; filter: drop-shadow(0 0 18px rgba(201, 184, 255, 0.35)); }
  .art-note { position: absolute; bottom: 0.4rem; right: 0.6rem; margin: 0; font-size: 0.7rem; color: var(--dim); }
  .prose p { margin: 0 0 0.7rem; }
  .prose p:last-child { margin: 0; }
  .muted { color: var(--muted); margin: 0; }
  .abilities h3 { font-family: var(--sans); font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--lav-2); margin: 0.2rem 0 0.5rem; font-weight: 600; }
  .ab-group + .ab-group { margin-top: 1rem; }
  .hint { text-transform: none; letter-spacing: 0; color: var(--dim); font-weight: 400; }
  .spell { position: relative; border: 1px solid var(--line); border-left: 3px solid var(--lav-2); background: rgba(10, 6, 20, 0.45); padding: 0.6rem 0.75rem; }
  .spell + .spell { margin-top: 0.5rem; }
  .spell header { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; margin-bottom: 0.3rem; padding-right: 4.4rem; }
  .sname { font-family: var(--serif); font-size: 1rem; }
  .stag { font-size: 0.66rem; letter-spacing: 0.08em; padding: 0.06rem 0.4rem; border: 1px solid var(--line); color: var(--muted); border-radius: 2px; }
  .stag.cost { color: var(--gold); border-color: #e8c46a66; }
  .spell p { margin: 0; color: #ddd5f5; }
  .latent .spell { opacity: 0.62; border-left-color: var(--dim); }
  .latent .spell:hover { opacity: 1; }
  .moves { list-style: none; margin: 0.5rem 0 0; padding: 0; }
  .moves li { padding: 0.45rem 0.6rem; background: rgba(124, 77, 255, 0.1); border: 1px dashed var(--line); font-size: 0.92rem; }
  .moves li + li { margin-top: 0.35rem; }
  .copybtn { position: absolute; top: 0.45rem; right: 0.5rem; font-family: var(--sans); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; background: none; border: 1px solid var(--line); color: var(--lav-2); padding: 0.18rem 0.55rem; cursor: pointer; border-radius: 3px; }
  .copybtn:hover { color: #fff; border-color: var(--lav-2); }
  .mname { font-weight: 600; color: #fff; margin-right: 0.2rem; }
  .table-list { margin: 0; padding: 0; list-style: none; font-size: 0.9rem; }
  .table-list li { padding: 0.25rem 0; border-bottom: 1px solid rgba(201, 184, 255, 0.1); }
  .desc { display: flow-root; }
  .stone { float: right; width: 96px; height: 96px; margin: 0 0 0.5rem 1rem; filter: drop-shadow(0 0 10px rgba(201, 184, 255, 0.25)); }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 0.3rem 1rem; margin: 0; }
  .facts dt { color: var(--muted); font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .facts dd { margin: 0; }
  .statgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .stat { border: 1px solid var(--line); padding: 0.45rem 0.6rem; background: rgba(10, 6, 20, 0.45); display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.25rem; }
  .stat .k { font-size: 0.72rem; letter-spacing: 0.14em; color: var(--muted); }
  .stat .v { font-family: var(--serif); font-size: 1.35rem; }
  .meter { grid-column: 1 / -1; height: 3px; background: rgba(255, 255, 255, 0.08); }
  .meter i { display: block; height: 100%; background: linear-gradient(90deg, var(--lav-2), var(--lav)); }
  .statnote { color: var(--muted); font-size: 0.8rem; margin: 0.6rem 0 0; }
  .related > div + div { margin-top: 0.6rem; }
  .attach { display: grid; grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); gap: 0.5rem; }
  .att { display: flex; align-items: center; gap: 0.55rem; padding: 0.4rem 0.55rem; border: 1px solid rgba(255,255,255,.12); border-radius: 8px; text-decoration: none; color: inherit; background: rgba(255,255,255,.03); }
  .att:hover { border-color: rgba(255,255,255,.35); background: rgba(255,255,255,.07); }
  .att span { font-size: .9rem; line-height: 1.2; }
  .rlabel { display: block; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.3rem; }
  .note { color: var(--muted); font-size: 0.82rem; margin: 0.8rem 0 0; }
  .codex-foot { margin-top: 0.9rem; }
  .footrow { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
  .credit { margin-left: auto; color: var(--muted); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; }
  @media (max-width: 820px) {
    .cols { grid-template-columns: 1fr; }
    .nameline h1 { font-size: 1.5rem; }
    .credit { margin-left: 0; }
  }
</style>
