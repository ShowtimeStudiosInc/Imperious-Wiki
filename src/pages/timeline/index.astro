---
import Site from '../../layouts/Site.astro';
import { url } from '../../lib/gems';
import { pages, EMBLEMS, PART_ICONS } from '../../lib/timeline';
import type { Node } from '../../lib/timeline';
// Where each node sits along the line, in percent.
const xs = (n: number) => (n === 1 ? [46] : n === 2 ? [24, 64] : Array.from({ length: n }, (_, i) => 14 + (i * 66) / (n - 1)));
// Each stretch of the line (0, Side-B, 1A, 1B, 2A) starts halfway between the last node of one segment and the first of the next.
const segmentsFor = (nodes: Node[]) => {
  const x = xs(nodes.length);
  const out: { label: string; from: number }[] = [];
  nodes.forEach((n, i) => {
    if (i === 0) out.push({ label: n.segment, from: 6 });
    else if (n.segment !== nodes[i - 1].segment) out.push({ label: n.segment, from: (x[i - 1] + x[i]) / 2 });
  });
  return out;
};
---
<Site title="Timeline" description="The history of the Gempire, Era by Era, and the story of the server.">
  <main class="tl-page" data-pagefind-body>
    <div class="frame">
      <p class="label">Timeline</p>
      {pages.map((p, pi) => (
        <section class={`tl-panel${pi === 0 ? ' on' : ''}`} id={p.key} data-key={p.key} aria-label={p.title}>
          <header class="ph">
            <h1>{p.title}</h1>
            <p>{p.sub}</p>
          </header>
          <div class="track">
            <span class="line" />
            {segmentsFor(p.nodes).map((s) => (
              <span class="seg" style={`--x:${s.from}%`}><span>{s.label}</span></span>
            ))}
            {p.nodes.map((n, i) => {
              const x = xs(p.nodes.length)[i];
              const up = i % 2 === 0;
              const Tag = n.status === 'open' ? 'a' : 'div';
              return (
                <div class={`node ${up ? 'up' : 'down'} ${n.status}${x > 70 ? ' flip' : ''}`} style={`--x:${x}%`}>
                  <span class="dot" />
                  <span class="stem" />
                  <Tag class="medal-link" href={n.status === 'open' ? url(`/timeline/${n.slug}/`) : undefined}>
                    <span class="medal"><svg viewBox="0 0 100 100" aria-hidden="true" set:html={EMBLEMS[n.emblem] ?? ''} /></span>
                  </Tag>
                  <div class="info">
                    {n.current && <span class="cur">Current Event</span>}
                    {n.status === 'open' ? <a class="t" href={url(`/timeline/${n.slug}/`)}>{n.title}</a> : <span class="t">{n.title}</span>}
                    {n.name && <span class="nm">{n.name}</span>}
                    <span class="tag">{n.tagline}</span>
                    {n.status !== 'open' && <span class="note">{n.note}</span>}
                    {n.parts.length > 0 && (
                      <span class="parts">
                        {n.parts.map((pt, k) => (
                          <a href={url(`/timeline/${n.slug}/#${pt.id}`)} title={pt.title} aria-label={pt.title}>
                            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={PART_ICONS[k % PART_ICONS.length]} />
                          </a>
                        ))}
                      </span>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      ))}
      <button class="arrow prev" type="button" aria-label="Previous page"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M7 1L3 5l4 4z" /></svg></button>
      <button class="arrow next" type="button" aria-label="Next page"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M3 1l4 4-4 4z" /></svg></button>
      <nav class="pager" aria-label="Timeline pages">
        {pages.map((p, pi) => <button type="button" data-go={pi} aria-label={p.title} aria-current={pi === 0 ? 'true' : undefined}><span>{p.title}</span></button>)}
      </nav>
    </div>
  </main>
</Site>

<script>
  const panels = [...document.querySelectorAll<HTMLElement>('.tl-panel')];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.pager button')];
  let at = 0;
  const show = (i: number, push = true) => {
    at = (i + panels.length) % panels.length;
    panels.forEach((p, k) => p.classList.toggle('on', k === at));
    tabs.forEach((t, k) => (k === at ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    if (push) history.replaceState(null, '', `#${panels[at].dataset.key}`);
  };
  document.querySelector('.arrow.prev')?.addEventListener('click', () => show(at - 1));
  document.querySelector('.arrow.next')?.addEventListener('click', () => show(at + 1));
  tabs.forEach((t, k) => t.addEventListener('click', () => show(k)));
  document.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(at - 1); if (e.key === 'ArrowRight') show(at + 1); });
  const start = panels.findIndex((p) => `#${p.dataset.key}` === location.hash);
  if (start > 0) show(start, false);
</script>

<style>
  .tl-page { padding: 1.4rem clamp(0.6rem, 2vw, 1.6rem) 2.5rem; }
  .frame { position: relative; max-width: 1280px; margin: 0 auto; min-height: 720px; border: 1px solid var(--line); background:
      radial-gradient(900px 420px at 50% 52%, rgba(124, 77, 255, 0.16), transparent 70%),
      linear-gradient(180deg, rgba(8, 5, 16, 0.82), rgba(14, 9, 28, 0.9)); overflow: hidden; }
  .frame::before, .frame::after { content: ''; position: absolute; width: 22px; height: 22px; border: 1px solid var(--line-strong); pointer-events: none; }
  .frame::before { top: 8px; left: 8px; border-right: 0; border-bottom: 0; }
  .frame::after { bottom: 8px; right: 8px; border-left: 0; border-top: 0; }
  .label { position: absolute; top: 0.9rem; left: 50%; transform: translateX(-50%); margin: 0; font-size: 0.72rem; letter-spacing: 0.5em; text-transform: uppercase; color: var(--muted); }

  .tl-panel { display: none; position: relative; min-height: 720px; }
  .tl-panel.on { display: block; animation: fade 0.35s ease; }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  .ph { position: absolute; top: 2.6rem; left: 3.2rem; max-width: 38rem; }
  .ph h1 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: 1.5rem; letter-spacing: 0.06em; }
  .ph p { margin: 0.2rem 0 0; color: var(--muted); font-size: 0.9rem; }

  .track { position: absolute; inset: 0; }
  .line { position: absolute; left: 6%; right: 6%; top: 57%; height: 1px; background: var(--line-strong); }
  .line::after { content: ''; position: absolute; left: 100%; top: 0; width: 5%; border-top: 1px dashed var(--line); }

  .seg { position: absolute; left: var(--x); top: 57%; height: 0; }
  .seg::before { content: ''; position: absolute; left: 0; top: -9px; width: 1px; height: 18px; background: var(--line-strong); }
  .seg span { position: absolute; left: 8px; top: 6px; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold); white-space: nowrap; }
  .node { position: absolute; left: var(--x); top: 57%; width: 0; height: 0; --c: #e9e1ff; }
  .node.locked { --c: #8f86ad; }
  .node.sealed { --c: #5d5578; }
  .dot { position: absolute; left: -4px; top: -4px; width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .node.open .dot { box-shadow: 0 0 0 4px rgba(233, 225, 255, 0.12); }
  .stem { position: absolute; left: 0; width: 1px; background: var(--line-strong); }
  .up .stem { bottom: 0; height: 86px; }
  .down .stem { top: 0; height: 86px; }
  .stem::after { content: ''; position: absolute; left: 1px; width: 10px; height: 7px; background: var(--uf); clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .up .stem::after { top: 14px; }
  .down .stem::after { bottom: 14px; }

  .medal-link { position: absolute; left: -54px; width: 108px; height: 120px; display: grid; place-items: center; color: var(--c); }
  .up .medal-link { bottom: 86px; }
  .down .medal-link { top: 86px; }
  .medal { position: relative; width: 100%; height: 100%; display: grid; place-items: center; transition: transform 0.25s ease, filter 0.25s ease; }
  .medal::before, .medal::after { content: ''; position: absolute; clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); }
  .medal::before { inset: 0; background: var(--c); opacity: 0.55; }
  .medal::after { inset: 3px; background: linear-gradient(160deg, #241a3a, #0d0818 70%); }
  .medal svg { position: relative; z-index: 1; width: 52%; height: 52%; fill: currentColor; }
  .node.locked .medal svg, .node.sealed .medal svg { opacity: 0.55; }
  a.medal-link:hover .medal, a.medal-link:focus-visible .medal { transform: scale(1.07); filter: drop-shadow(0 0 14px rgba(233, 225, 255, 0.45)); }

  .info { position: absolute; left: 66px; width: clamp(150px, 15vw, 230px); display: grid; gap: 0.15rem; }
  .up .info { top: -206px; }
  .down .info { top: 92px; }
  .node.flip .info { left: auto; right: 66px; text-align: right; }
  .node.flip .parts { justify-content: flex-end; }
  .cur { font-size: 0.72rem; color: #d8e36a; letter-spacing: 0.04em; }
  .t { font-size: 1.02rem; font-weight: 600; letter-spacing: 0.28em; text-transform: uppercase; color: var(--c); line-height: 1.25; }
  a.t:hover { color: #fff; }
  .nm { font-family: var(--serif); font-size: 0.82rem; color: var(--muted); }
  .tag { font-size: 0.85rem; color: var(--text); opacity: 0.9; }
  .note { font-size: 0.7rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--dim); margin-top: 0.15rem; }
  .parts { display: flex; flex-wrap: wrap; align-items: center; gap: 0.15rem; margin-top: 0.4rem; }
  .parts a { display: inline-grid; place-items: center; width: 26px; height: 26px; color: var(--c); opacity: 0.85; }
  .parts a + a::before { content: ''; width: 6px; height: 1px; background: var(--line-strong); margin-right: 2px; position: relative; left: -4px; }
  .parts a { position: relative; }
  .parts a + a { margin-left: 6px; }
  .parts a + a::before { position: absolute; left: -7px; top: 50%; }
  .parts a:hover { opacity: 1; color: #fff; }
  .parts svg { width: 18px; height: 18px; fill: currentColor; }

  .arrow { position: absolute; top: 57%; transform: translateY(-50%); width: 28px; height: 64px; display: grid; place-items: center; background: rgba(13, 8, 24, 0.7); border: 1px solid var(--line-strong); color: var(--text); cursor: pointer; z-index: 3; }
  .arrow svg { width: 10px; height: 10px; fill: currentColor; }
  .arrow:hover { background: rgba(124, 77, 255, 0.3); }
  .prev { left: 0.8rem; }
  .next { right: 0.8rem; }
  .pager { position: absolute; bottom: 1.1rem; left: 50%; transform: translateX(-50%); display: flex; gap: 0.5rem; z-index: 3; }
  .pager button { background: none; border: 0; padding: 0.4rem 0; cursor: pointer; }
  .pager span { display: block; width: 38px; height: 3px; background: var(--line); font-size: 0; }
  .pager button[aria-current] span { background: var(--text); }

  @media (max-width: 860px) {
    .frame, .tl-panel { min-height: 0; }
    .label { position: static; transform: none; text-align: center; padding-top: 0.9rem; }
    .ph { position: static; padding: 0.6rem 1.2rem 0; }
    .track { position: static; padding: 1rem 1.2rem 4.5rem 2.2rem; display: grid; gap: 1.4rem; }
    .line { display: none; }
    .line::after { display: none; }
    .node { position: relative; left: 0 !important; top: 0; width: auto; height: auto; display: grid; grid-template-columns: 72px 1fr; gap: 0.9rem; align-items: center; }
    .dot, .stem { display: none; }
    .seg { display: none; }
    .medal-link { position: static; width: 72px; height: 80px; }
    .info, .node.flip .info { position: static; width: auto; text-align: left; }
    .node.flip .parts { justify-content: flex-start; }
    .arrow { top: auto; bottom: 0.7rem; transform: none; height: 32px; }
  }
  @media (prefers-reduced-motion: reduce) { .tl-panel.on { animation: none; } .medal { transition: none; } }
</style>
