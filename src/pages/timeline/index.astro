---
import Site from '../../layouts/Site.astro';
import { url } from '../../lib/gems';
import { pages, layout, EMBLEMS } from '../../lib/timeline';
import type { Track } from '../../lib/timeline';

// Segment marks (1A, 1B, 2A...) start halfway between the last event of one segment and the first of the next.
// The page the Timeline opens on (a page with start: true, else the first).
const startAt = Math.max(0, pages.findIndex((p) => p.start));
const segments = (t: Track, pos: Map<string, number>) => {
  const out: { label: string; x: number }[] = [];
  t.events.forEach((e, i) => {
    if (!e.segment) return;
    const prev = t.events[i - 1];
    if (!prev) out.push({ label: e.segment, x: 15.5 });
    else if (prev.segment !== e.segment) out.push({ label: e.segment, x: ((pos.get(prev.id) ?? 0) + (pos.get(e.id) ?? 0)) / 2 });
  });
  return out;
};
---
<Site title="Timeline" description="The history of the Gempire, Era by Era, and the story of the server.">
  <main class="tl-page" data-pagefind-body>
    <p class="label">Timeline</p>
    {pages.map((p, pi) => {
      const pos = layout(p);
      return (
        <section class={`tl-panel${pi === startAt ? ' on' : ''}`} data-start={pi === startAt ? '' : undefined} id={`tl-${p.key}`} data-key={p.key} aria-label={p.title} style={`--rows:${p.tracks.length}`}>
          <header class="ph">
            <h1>{p.title}</h1>
            <p>{p.sub}</p>
            {p.link && <a class="plink" href={url(p.link.href)}>{p.link.label} ›</a>}
          </header>
          <div class="tracks">
            {p.tracks.map((t) => {
              const end = t.ends_at ? pos.get(t.ends_at) : undefined;
              return (
                <div class={`track${t.style === 'dotted' ? ' dotted' : ''}${t.events.length > 10 ? ' dense' : ''}`} style={`--c:${t.color}`}>
                  <div class="tlabel">
                    <span class="tl-name">{t.label}</span>
                    {t.name && <span class="tl-sub">{t.name}</span>}
                  </div>
                  <span class="line" style={`left:${t.from_left ? 0 : 15}%;right:${end != null ? 100 - end : t.to_right ? 0 : 3}%`} />
                  {t.from_left && <span class="cap in" aria-hidden="true" />}
                  {t.to_right && <span class="cap out" aria-hidden="true" />}
                  {end != null && <span class="merge" style={`left:${end}%`} aria-hidden="true" />}
                  {segments(t, pos).map((s) => <span class="seg" style={`left:${s.x}%`}><span>{s.label}</span></span>)}
                  {t.events.length === 0 && t.note && <span class="tnote">{t.note}</span>}
                  {t.events.map((e, i) => {
                    const big = !!(e.includes?.length || e.big);
                    const x = pos.get(e.id) ?? 50;
                    const status = e.status ?? 'open';
                    const Tag = status === 'open' && e.link ? 'a' : 'div';
                    return (
                      <Tag class={`ev ${i % 2 ? 'below' : 'above'} ${status}${e.kind === 'news' ? ' news' : ''}${big ? ' chapter' : ''}${e.big ? ' huge' : ''}${x > 82 ? ' flip' : ''}`} style={`left:${x}%`} href={Tag === 'a' ? url(e.link!) : undefined}>
                        {big
                          ? <span class="cmark" aria-hidden="true"><svg viewBox="0 0 100 100" set:html={EMBLEMS[e.emblem ?? 'five'] ?? ''} /></span>
                          : <span class="mark" aria-hidden="true" />}
                        <span class="txt">
                          {e.current && <span class="cur">Current Event</span>}
                          {e.kind === 'news' && <span class="src">The Homeworld Times</span>}
                          {e.when && <span class="when">{e.when}</span>}
                          {big && <span class="ck">{e.kicker ?? 'Chapter'}</span>}
                          <span class="et">{e.title}</span>
                          {big && e.tagline && <span class="ctag">{e.tagline}</span>}
                          {status === 'pending' && <span class="st">Recap coming</span>}
                          {status === 'sealed' && <span class="st">Sealed</span>}
                        </span>
                      </Tag>
                    );
                  })}
                </div>
              );
            })}
          </div>
        </section>
      );
    })}
    <button class="arrow prev" type="button" aria-label="Previous Era"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M7 1L3 5l4 4z" /></svg></button>
    <button class="arrow next" type="button" aria-label="Next Era"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M3 1l4 4-4 4z" /></svg></button>
    <nav class="pager" aria-label="Eras">
      {pages.map((p, pi) => <button type="button" data-go={pi} aria-current={pi === startAt ? 'true' : undefined}><span class="bar" /><span class="pl">{p.title}</span></button>)}
    </nav>
  </main>
</Site>

<script>
  const fit = () => {
    const bar = document.querySelector<HTMLElement>('.topbar');
    document.documentElement.style.setProperty('--tb', `${bar ? bar.offsetHeight : 0}px`);
  };
  fit();
  addEventListener('resize', fit);
  const panels = [...document.querySelectorAll<HTMLElement>('.tl-panel')];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.pager button')];
  let at = 0;
  const show = (i: number, push = true) => {
    at = Math.max(0, Math.min(panels.length - 1, i));
    panels.forEach((p, k) => p.classList.toggle('on', k === at));
    tabs.forEach((t, k) => (k === at ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    document.querySelector('.arrow.prev')?.toggleAttribute('disabled', at === 0);
    document.querySelector('.arrow.next')?.toggleAttribute('disabled', at === panels.length - 1);
    if (push) history.replaceState(null, '', `#${panels[at].dataset.key}`);
  };
  document.querySelector('.arrow.prev')?.addEventListener('click', () => show(at - 1));
  document.querySelector('.arrow.next')?.addEventListener('click', () => show(at + 1));
  tabs.forEach((t, k) => t.addEventListener('click', () => show(k)));
  document.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(at - 1); if (e.key === 'ArrowRight') show(at + 1); });
  const start = panels.findIndex((p) => `#${p.dataset.key}` === location.hash);
  addEventListener('hashchange', () => { const k = panels.findIndex((p) => `#${p.dataset.key}` === location.hash); if (k >= 0) show(k, false); });
  const home = Math.max(0, panels.findIndex((p) => p.hasAttribute('data-start')));
  show(start >= 0 ? start : home, false);
</script>

<style>
  .tl-page { position: relative; height: calc(100dvh - var(--tb, 56px)); min-height: 560px; overflow: hidden; background:
      radial-gradient(1100px 520px at 50% 55%, rgba(124, 77, 255, 0.16), transparent 70%),
      linear-gradient(180deg, rgba(8, 5, 16, 0.86), rgba(14, 9, 28, 0.94)); border-bottom: 1px solid var(--line); }
  .label { position: absolute; top: 0.9rem; left: 50%; transform: translateX(-50%); margin: 0; font-size: 0.72rem; letter-spacing: 0.5em; text-transform: uppercase; color: var(--muted); z-index: 2; }

  .plink { display: inline-block; margin-top: 0.6rem; font: 600 0.72rem/1 var(--sans); letter-spacing: 0.2em; text-transform: uppercase; color: var(--lav); position: relative; z-index: 3; }
  .tl-panel { display: none; position: absolute; inset: 0; }
  .tl-panel.on { display: block; animation: fade 0.35s ease; }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  .ph { position: absolute; top: 1.6rem; left: 3.4rem; max-width: 34rem; z-index: 2; }
  .ph h1 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(1.4rem, 2.2vw, 1.9rem); letter-spacing: 0.06em; }
  .ph p { margin: 0.15rem 0 0; color: var(--muted); font-size: 0.88rem; }

  .tracks { position: absolute; left: 0; right: 0; top: 6.5rem; bottom: 4.2rem; display: grid; grid-template-rows: repeat(var(--rows), 1fr); }
  .track { position: relative; --c: #e9e1ff; }
  .tlabel { position: absolute; left: 3.4rem; top: 50%; transform: translateY(-50%); width: calc(15% - 4.4rem); min-width: 120px; display: grid; line-height: 1.25; z-index: 2; padding: 0.3rem 0.6rem 0.3rem 0; background: linear-gradient(90deg, rgba(10, 6, 20, 0.95) 80%, transparent); }
  .tl-name { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--c); }
  .tl-sub { font-family: var(--serif); font-size: 0.78rem; color: var(--muted); }
  .line { position: absolute; top: 50%; height: 2px; margin-top: -1px; background: var(--c); opacity: 0.75; }
  .dotted .line { background: none; border-top: 2px dotted var(--c); height: 0; }
  .cap { position: absolute; top: 50%; width: 0; height: 0; border: 6px solid transparent; margin-top: -6px; }
  .cap.in { left: 0; border-left-color: var(--c); }
  .cap.out { right: 0; border-left-color: var(--c); }
  .merge { position: absolute; top: 50%; width: 2px; height: calc(50% + 1px); background: linear-gradient(var(--c), transparent); opacity: 0.6; }
  .seg { position: absolute; top: 50%; height: 0; }
  .seg::before { content: ''; position: absolute; left: 0; top: -12px; width: 1px; height: 24px; background: var(--c); opacity: 0.8; }
  .seg span { position: absolute; left: 6px; top: 0.45rem; padding: 0 0.3rem; background: rgba(10, 6, 20, 0.9); line-height: 1.4; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.3em; color: var(--gold); }
  .tnote { position: absolute; left: 50%; top: calc(50% + 0.7rem); transform: translateX(-50%); font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--dim); }

  .ev { position: absolute; top: 50%; width: 0; height: 0; color: var(--text); text-decoration: none; z-index: 1; }
  .mark { position: absolute; left: -7px; top: -7px; width: 14px; height: 14px; background: var(--c); transform: rotate(45deg); box-shadow: 0 0 0 4px rgba(13, 8, 24, 0.9); transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .ev.pending .mark, .ev.sealed .mark { background: #0d0818; border: 2px solid var(--c); }
  .ev.sealed { --c: #6f6690; }
  .cmark { position: absolute; left: -32px; top: -36px; width: 64px; height: 72px; display: grid; place-items: center; color: var(--c); z-index: 1; }
  .cmark::before, .cmark::after { content: ''; position: absolute; clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); }
  .cmark::before { inset: 0; background: var(--c); }
  .cmark::after { inset: 3px; background: linear-gradient(160deg, #241a3a, #0d0818 70%); }
  .cmark svg { position: relative; z-index: 1; width: 50%; height: 50%; fill: currentColor; }
  .chapter.above .txt { bottom: 44px; }
  .chapter.below .txt { top: 44px; }
  .chapter .txt { left: -90px; width: 180px; }
  .chapter .et { font-size: 0.95rem; letter-spacing: 0.22em; text-transform: uppercase; }
  .ck { font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--c); }
  .ctag { font-size: 0.74rem; color: var(--muted); }
  .huge .cmark { left: -48px; top: -54px; width: 96px; height: 108px; }
  .huge.above .txt { bottom: 64px; }
  .huge.below .txt { top: 64px; }
  .huge .txt { left: -150px; width: 300px; }
  .huge .et { font-size: 1.15rem; }
  a.ev.chapter:hover .cmark { filter: drop-shadow(0 0 12px var(--c)); }
  .ev.news .mark { transform: none; border-radius: 50%; width: 11px; height: 11px; left: -5.5px; top: -5.5px; background: #0d0818; border: 2px solid #ff6b5e; }
  a.ev.news:hover .mark { transform: scale(1.35); }
  .src { font-size: 0.56rem; letter-spacing: 0.2em; text-transform: uppercase; color: #ff8a7e; }
  .txt { position: absolute; left: -64px; width: 128px; display: grid; justify-items: center; text-align: center; gap: 0.05rem; }
  .above .txt { bottom: 14px; }
  .below .txt { top: 14px; }
  .flip .txt { left: auto; right: -14px; justify-items: end; text-align: right; }
  .when { font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); line-height: 1.3; }
  .et { font-size: 0.82rem; font-weight: 600; letter-spacing: 0.06em; line-height: 1.25; color: var(--text); }
  .st { font-size: 0.6rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--dim); }
  .cur { font-size: 0.66rem; color: #d8e36a; }
  .dense .txt { left: -54px; width: 108px; }
  .dense .et { font-size: 0.74rem; letter-spacing: 0.03em; }
  .dense .when { font-size: 0.58rem; letter-spacing: 0.06em; }
  a.ev:hover .mark, a.ev:focus-visible .mark { transform: rotate(45deg) scale(1.35); box-shadow: 0 0 0 4px rgba(13, 8, 24, 0.9), 0 0 14px var(--c); }
  a.ev:hover .et, a.ev:focus-visible .et { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  a.ev:focus-visible { outline: none; }

  .arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 30px; height: 70px; display: grid; place-items: center; background: rgba(13, 8, 24, 0.75); border: 1px solid var(--line-strong); color: var(--text); cursor: pointer; z-index: 3; }
  .arrow svg { width: 10px; height: 10px; fill: currentColor; }
  .arrow:hover:not([disabled]) { background: rgba(124, 77, 255, 0.3); }
  .arrow[disabled] { opacity: 0.3; cursor: default; }
  .prev { left: 0.6rem; }
  .next { right: 0.6rem; }
  .pager { position: absolute; bottom: 1rem; left: 50%; transform: translateX(-50%); display: flex; gap: 1.2rem; z-index: 3; }
  .pager button { background: none; border: 0; padding: 0.2rem 0; cursor: pointer; display: grid; justify-items: center; gap: 0.35rem; color: var(--dim); }
  .pager .bar { display: block; width: 46px; height: 3px; background: var(--line); }
  .pager .pl { font-size: 0.66rem; letter-spacing: 0.3em; text-transform: uppercase; }
  .pager button[aria-current] .bar { background: var(--text); }
  .pager button[aria-current] { color: var(--text); }

  /* Phones: tracks stack as lists */
  @media (max-width: 820px) {
    .tl-page { height: auto; min-height: calc(100dvh - var(--tb, 56px)); overflow: visible; padding-bottom: 5rem; }
    .tl-panel { position: static; }
    .label { position: static; transform: none; text-align: center; padding-top: 0.9rem; }
    .ph { position: static; padding: 0.4rem 1.2rem 0.6rem; }
    .tracks { position: static; display: grid; grid-template-rows: none; gap: 1.4rem; padding: 0 1.2rem; }
    .tlabel { position: static; transform: none; width: auto; background: none; margin-bottom: 0.5rem; }
    .line, .cap, .merge, .seg { display: none; }
    .track { border-left: 2px solid var(--c); padding-left: 0.9rem; }
    .dotted.track { border-left-style: dotted; }
    .tnote { position: static; transform: none; display: block; }
    .ev { position: relative; display: block; width: auto; height: auto; left: 0 !important; top: 0; padding: 0.35rem 0 0.35rem 1.4rem; }
    .mark { top: 0.7rem; left: 0; width: 10px; height: 10px; }
    .cmark { position: absolute; left: -10px; top: 0.2rem; width: 26px; height: 29px; }
    .chapter .txt { width: auto; }
    .huge .cmark { left: -14px; top: 0.1rem; width: 34px; height: 38px; }
    .huge { padding-left: 1.9rem; margin: 0.4rem 0; }
    .huge .txt { left: auto; width: auto; }
    .huge .et { font-size: 1rem; }
    .txt, .flip .txt { position: static; width: auto; justify-items: start; text-align: left; }
    .arrow { top: auto; bottom: 1rem; transform: none; height: 34px; }
  }
  @media (prefers-reduced-motion: reduce) { .tl-panel.on { animation: none; } .mark { transition: none; } }
</style>
