---
import Site from '../layouts/Site.astro';
import { builderDatabase } from '../lib/builder-data';
import { url } from '../lib/gems';

const db = await builderDatabase();
// Keep the JSON safe inside a <script> tag.
const payload = `window.GEM_DATABASE = ${JSON.stringify(db).replace(/</g, '\\u003c')};`;

const diamonds = [
  ['Alpha Black Diamond', '0'],
  ['Omega White Diamond', '0B'],
  ['Theta Gold Diamond', '1'],
  ['Metal-Society', '01'],
  ['Epsilon Blue Diamond', '2'],
  ['Nightshade Violet Diamond', '3'],
  ['Maroon Red Diamond', '4'],
  ['Bi-Colored Kandy Diamond', '5'],
  ['Saturn Light Diamond', '6'],
];
const ranks = [
  ['5.2', 'Low Servant'], ['5.1', 'High Servant'],
  ['4.3', 'Low Service Trade'], ['4.2', 'Median Service Trade'], ['4.1', 'High Service Trade'],
  ['3.3', 'Low Militia'], ['3.2', 'Median Militia'], ['3.1', 'High Militia'],
  ['2.3', 'Low Authoritative/Aristocratic'], ['2.2', 'Median Authoritative/Aristocratic'], ['2.1', 'High Authoritative/Aristocratic'],
  ['1.2', 'Transcendent'],
];
---
<Site title="Gem Builder" description="Build a Gem from any Gem-Type on the wiki, add an Era and cut, and see the stats and abilities you end up with.">
  <link slot="head" rel="stylesheet" href={url('/gem-builder/builder.css')} />
  <main class="wrap gb" data-pagefind-body>
    <header class="gb-head">
      <h1>Gem Builder</h1>
      <p>Pick a Gem-Type, an Era and a cut, and see the stats and abilities your Gem starts with. Every list here comes from the wiki, so new Gem-Types show up as soon as they are added.</p>
      <nav class="gb-jump" aria-label="Tools on this page">
        <a class="btn" href="#builder">Builder</a>
        <a class="btn" href="#fusion">Fusion Stats</a>
        <a class="btn" href="#abilities-check">Ability Checker</a>
        <a class="btn" href="#facet">Facet &amp; Cut</a>
        <a class="btn" href="#sheet">Sheet Checker</a>
      </nav>
    </header>

    <section class="builder" id="builder" aria-label="Gem builder">
      <div class="step">
        <span class="step-number">1</span>
        <div>
          <label for="faction">Faction</label>
          <select id="faction"></select>
        </div>
      </div>
      <div class="step">
        <span class="step-number">2</span>
        <div>
          <label for="gem">Gem-Type</label>
          <select id="gem"></select>
        </div>
      </div>
      <div class="step hidden" id="prism-step">
        <span class="step-number">3</span>
        <div>
          <label for="prism">Prism shift</label>
          <select id="prism"></select>
          <p class="field-note">Leave unshifted to keep Clear Quartz base stats.</p>
        </div>
      </div>
      <div class="step">
        <span class="step-number">4</span>
        <div>
          <label for="era">Era or unique modifier</label>
          <select id="era"></select>
          <p class="field-note">Era 0-1 Metal Society is only for Metal Gem-Types.</p>
        </div>
      </div>
      <div class="step">
        <span class="step-number">5</span>
        <div>
          <label for="cut">Cut quality</label>
          <select id="cut"></select>
        </div>
      </div>
      <div class="step hidden" id="defect-stats-step">
        <span class="step-number">5a</span>
        <div class="defect-stat-selects">
          <div>
            <label for="defect-stat-a">First defective stat</label>
            <select id="defect-stat-a"></select>
          </div>
          <div>
            <label for="defect-stat-b">Second defective stat</label>
            <select id="defect-stat-b"></select>
          </div>
        </div>
      </div>
      <div class="step">
        <span class="step-number">6</span>
        <div>
          <label for="level">Level</label>
          <input id="level" type="number" min="1" max="30" value="1" />
        </div>
      </div>
    </section>

    <section class="notice" id="notice" aria-live="polite"></section>

    <section class="result" aria-live="polite">
      <div class="result-heading">
        <div>
          <p class="eyebrow">RESULT</p>
          <h2 id="result-name">Choose a Gem-Type</h2>
        </div>
        <div class="result-links">
          <img id="result-stone" alt="" hidden />
          <a id="result-link" class="btn" hidden>Open Gem-Type page</a>
          <div class="badges" id="badges"></div>
        </div>
      </div>
      <div class="profile">
        <div class="meta-card"><span id="rank-label">Rank</span><strong id="rank">Not assigned</strong></div>
        <div class="meta-card"><span>Height</span><strong id="height">Not assigned</strong></div>
        <div class="meta-card"><span>Level</span><strong id="result-level">1</strong></div>
        <div class="meta-card"><span>EXP to next level</span><strong id="next-exp">100</strong></div>
        <div class="meta-card"><span>Total EXP required</span><strong id="total-exp">0</strong></div>
      </div>
      <div class="stats" id="stats"></div>
      <div class="abilities">
        <h3>Abilities</h3>
        <ul id="abilities"></ul>
      </div>
    </section>

    <section class="result fusion-tool" id="fusion" aria-label="Fusion stat combiner">
      <div class="result-heading">
        <div>
          <p class="eyebrow">FUSION</p>
          <h2>Fusion Stats</h2>
          <p class="lede">Pick two Gem-Types to add up their base stats and see their abilities side by side.</p>
        </div>
      </div>
      <div class="fusion-selects">
        <div>
          <label for="fusion-a">First half</label>
          <select id="fusion-a"></select>
        </div>
        <div>
          <label for="fusion-b">Second half</label>
          <select id="fusion-b"></select>
        </div>
      </div>
      <h3 class="fusion-heading">Combined base stats</h3>
      <div class="stats" id="fusion-stats"></div>
      <div class="fusion-abilities">
        <article>
          <h3 id="fusion-a-name">First half's abilities</h3>
          <ul id="fusion-a-abilities"></ul>
        </article>
        <article>
          <h3 id="fusion-b-name">Second half's abilities</h3>
          <ul id="fusion-b-abilities"></ul>
        </article>
      </div>
      <h3 class="fusion-heading">Ideas for fusion abilities</h3>
      <div class="fusion-suggestions" id="fusion-suggestions"></div>
      <p class="field-note">These are only ideas to start from, not rules. See <a href={url('/rules/fusion/')}>Fusion</a> for how fusions actually work.</p>
    </section>

    <section class="result ability-checker" id="abilities-check" aria-label="Ability overlap checker">
      <div class="result-heading">
        <div>
          <p class="eyebrow">ABILITIES</p>
          <h2>Ability Checker</h2>
          <p class="lede">Type an ability name or what it does to see if a Gem-Type already has something like it.</p>
        </div>
      </div>
      <div class="ability-search-container">
        <label for="ability-search-input">Ability name or effect</label>
        <input id="ability-search-input" type="text" placeholder="e.g. 'Water Control' or 'healing'" />
        <button id="ability-search-btn">Search</button>
      </div>
      <div class="ability-results" id="ability-results">
        <p class="field-note">Enter an ability name to check it against every Gem-Type.</p>
      </div>
    </section>

    <section class="result facet-cut-generator" id="facet" aria-label="Facet and cut generator">
      <div class="result-heading">
        <div>
          <p class="eyebrow">FACET &amp; CUT</p>
          <h2>Facet &amp; Cut Maker</h2>
          <p class="lede">Make your Facet &amp; Cut code. United Frontier Gems and Cubic Zirconias don't have one. See <a href={url('/lore/how-gems-work/facet-and-cut/')}>Facet &amp; Cut</a> for what each part means.</p>
        </div>
      </div>

      <div class="code-generator-inputs">
        <div class="input-group">
          <label for="diamond-select">Diamond</label>
          <select id="diamond-select">
            <option value="">Choose a Diamond</option>
            {diamonds.map(([name, code]) => <option value={name}>{name} ({code})</option>)}
          </select>
        </div>
        <div class="input-group">
          <label for="kindergarten-input">Kindergarten name</label>
          <input id="kindergarten-input" type="text" placeholder="e.g. Beta Prime" />
        </div>
        <div class="input-group">
          <label for="social-standing-select">Rank</label>
          <select id="social-standing-select">
            <option value="">Choose a rank</option>
            {ranks.map(([n, label]) => <option value={n}>{n} {label}</option>)}
          </select>
        </div>
        <div class="input-group">
          <label for="facet-random-letter">Facet letter (any)</label>
          <input id="facet-random-letter" type="text" maxlength="1" placeholder="e.g. A" />
        </div>
        <div class="input-group">
          <label for="atk-stat-input">ATK after your Era</label>
          <input id="atk-stat-input" type="number" placeholder="e.g. 12" />
        </div>
        <div class="input-group">
          <label for="cut-random-letter">Cut letter (any)</label>
          <input id="cut-random-letter" type="text" maxlength="1" placeholder="e.g. C" />
        </div>
      </div>

      <button id="generate-codes-btn" class="generate-btn">Make code</button>

      <div class="code-results">
        <div class="code-result-item">
          <label>Facet</label>
          <div class="code-display">
            <span id="facet-result">---</span>
            <button class="copy-btn" data-target="facet-result">Copy</button>
          </div>
        </div>
        <div class="code-result-item">
          <label>Cut</label>
          <div class="code-display">
            <span id="cut-result">---</span>
            <button class="copy-btn" data-target="cut-result">Copy</button>
          </div>
        </div>
      </div>
    </section>

    <section class="result submission-validator" id="sheet" aria-label="Character sheet checker">
      <div class="result-heading">
        <div>
          <p class="eyebrow">SUBMISSIONS</p>
          <h2>Sheet Checker</h2>
          <p class="lede">Paste a filled-in <a href={url('/rules/templates/')}>Gem Template</a>. It checks for missing fields, compares your stats and height to your Gem-Type, and checks your Facet &amp; Cut. Staff still review everything.</p>
        </div>
      </div>
      <div class="validator-input">
        <label for="character-sheet-input">Character sheet</label>
        <textarea id="character-sheet-input" rows="12" placeholder="Paste your sheet here"></textarea>
      </div>
      <button id="validate-btn" class="validate-btn">Check sheet</button>
      <div class="validation-results" id="validation-results">
        <p class="field-note">Paste your sheet above and press Check sheet.</p>
      </div>
    </section>
  </main>
  <script is:inline set:html={payload} />
  <script is:inline src={url('/gem-builder/app.js')}></script>
</Site>
