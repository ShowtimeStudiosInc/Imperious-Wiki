---
import Site from '../layouts/Site.astro';
import { builderDatabase } from '../lib/builder-data';
import { url } from '../lib/gems';

const db = await builderDatabase();
// Keep the JSON safe inside a <script> tag.
const payload = `window.GEM_DATABASE = ${JSON.stringify(db).replace(/</g, '\\u003c')};`;

const diamonds = [
  ['Alpha Black Diamond', '0'],
  ['Omega White Diamond', '0B'],
  ['Theta Gold Diamond', '1'],
  ['Metal-Society', '01'],
  ['Epsilon Blue Diamond', '2'],
  ['Nightshade Violet Diamond', '3'],
  ['Maroon Red Diamond', '4'],
  ['Bi-Colored Kandy Diamond', '5'],
  ['Saturn Light Diamond', '6'],
];
---
<Site title="Submission Builder" description="Build your character submission for a single Gem or a fusion. Stats, abilities, Facet & Cut and the full Gem Template, saved on your device as you go.">
  <link slot="head" rel="stylesheet" href={url('/gem-builder/builder.css')} />
  <main class="wrap gb" data-pagefind-body>
    <header class="gb-head">
      <h1>Submission Builder</h1>
      <p>Build your whole character submission in one place. Pick a Gem-Type or two halves of a fusion, fill in who she is, and copy the finished Gem Template into Discord. Every list here comes from the wiki, so new Gem-Types show up as soon as they are added.</p>
      <div class="draft-bar" id="draft-bar">
        <span class="draft-dot" aria-hidden="true"></span>
        <span id="draft-status">Your work saves on this device as you type. No account needed.</span>
        <button type="button" class="mini-btn" id="start-over">Start over</button>
      </div>
      <nav class="gb-jump" aria-label="Parts of this page">
        <a class="btn" href="#gem">1. The Gem</a>
        <a class="btn" href="#facet">2. Facet &amp; Cut</a>
        <a class="btn" href="#details">3. Details</a>
        <a class="btn" href="#submission">4. Submission</a>
        <a class="btn" href="#abilities-check">Ability Checker</a>
        <a class="btn" href="#sheet">Sheet Checker</a>
      </nav>
    </header>

    <section class="result" id="gem" aria-label="The Gem">
      <div class="result-heading">
        <div>
          <p class="eyebrow">STEP 1</p>
          <h2>The Gem</h2>
          <p class="lede">Is your character one Gem, or a fusion of two? A fusion's stats are both halves added together, so you build each half first.</p>
        </div>
      </div>
      <div class="mode-toggle" role="group" aria-label="Character kind">
        <button type="button" data-mode="single" aria-pressed="true">◇ Single Gem</button>
        <button type="button" data-mode="fusion" aria-pressed="false">◈ Fusion</button>
      </div>

      <div id="single-area">
        <div class="picker" id="pick-s"></div>
        <div class="notice" id="notice-s" aria-live="polite"></div>
        <div class="gem-card" id="card-s"></div>
      </div>

      <div id="fusion-area" hidden>
        <div class="halves">
          <article class="half">
            <h3>First half</h3>
            <div class="picker compact" id="pick-a"></div>
            <div class="half-sum" id="sum-a"></div>
          </article>
          <article class="half">
            <h3>Second half</h3>
            <div class="picker compact" id="pick-b"></div>
            <div class="half-sum" id="sum-b"></div>
          </article>
        </div>
        <div class="notice" id="notice-f" aria-live="polite"></div>
        <div class="fusion-out">
          <div class="pf wide">
            <label for="fusion-type">Fusion Gem-Type</label>
            <input id="fusion-type" data-save="fusionType" type="text" autocomplete="off" />
            <div class="match-row" id="fusion-matches"></div>
          </div>
          <div class="profile" id="fusion-profile"></div>
          <div class="stats" id="fusion-stats"></div>
          <h3 class="fusion-heading">Abilities</h3>
          <p class="field-note">Untick anything she doesn't keep. Abilities that work well together can merge into one combined ability, and a fusion may have one Fusion Ability of her own.</p>
          <div class="fusion-abilities" id="fusion-ability-picks"></div>
          <div class="fa-grid">
            <div class="pf">
              <label for="fusion-ability-name">Fusion Ability name (optional)</label>
              <input id="fusion-ability-name" data-save="fusionAbilityName" type="text" autocomplete="off" />
            </div>
            <div class="pf">
              <label for="fusion-ability-desc">What it does</label>
              <input id="fusion-ability-desc" data-save="fusionAbilityDesc" type="text" autocomplete="off" />
            </div>
          </div>
          <details class="ideas" id="ideas">
            <summary>Ideas for a Fusion Ability</summary>
            <div class="fusion-suggestions" id="fusion-suggestions"></div>
            <p class="field-note">These are only places to start, not rules. See <a href={url('/rules/fusion/')}>Fusion</a> for how fusions work.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="result" id="facet" aria-label="Facet and Cut">
      <div class="result-heading">
        <div>
          <p class="eyebrow">STEP 2</p>
          <h2>Facet &amp; Cut</h2>
          <p class="lede">Where your Gem came from and how she was made. See <a href={url('/lore/how-gems-work/facet-and-cut/')}>Facet &amp; Cut</a> for what each part means.</p>
        </div>
      </div>
      <div id="facet-single">
        <div class="code-generator-inputs">
          <div class="input-group">
            <label for="diamond-select">Diamond</label>
            <select id="diamond-select" data-save="facet.diamond">
              <option value="">Choose a Diamond</option>
              {diamonds.map(([name, code]) => <option value={name}>{name} ({code})</option>)}
            </select>
          </div>
          <div class="input-group">
            <label for="kindergarten-input">Kindergarten name</label>
            <input id="kindergarten-input" data-save="facet.kg" type="text" placeholder="e.g. Beta Prime" autocomplete="off" />
          </div>
          <div class="input-group">
            <label for="facet-random-letter">Facet letter (any)</label>
            <input id="facet-random-letter" data-save="facet.fl" type="text" maxlength="1" placeholder="e.g. A" autocomplete="off" />
          </div>
          <div class="input-group">
            <label for="cut-random-letter">Cut letter (any)</label>
            <input id="cut-random-letter" data-save="facet.cl" type="text" maxlength="1" placeholder="e.g. C" autocomplete="off" />
          </div>
        </div>
        <p class="field-note" id="facet-auto"></p>
        <div class="code-results">
          <div class="code-result-item">
            <label>Your Facet &amp; Cut</label>
            <div class="code-display">
              <span id="facet-result">---</span>
              <button class="copy-btn" type="button" data-target="facet-result">Copy</button>
            </div>
          </div>
        </div>
      </div>
      <div id="facet-fusion" hidden>
        <div class="pf">
          <label for="fusion-facet">Both halves' Facet &amp; Cut codes</label>
          <input id="fusion-facet" data-save="fusionFacet" type="text" placeholder="e.g. 4M2O - 11XA / 2B3K - 9XC" autocomplete="off" />
          <p class="field-note">Copy each half's code from her own sheet. Leave out any half from the United Frontier or a Cubic Zirconia, since they don't have one.</p>
        </div>
      </div>
      <p class="field-note" id="facet-none" hidden>United Frontier Gems and Cubic Zirconias don't have a Facet &amp; Cut, so you can skip this step.</p>
    </section>

    <section class="result" id="details" aria-label="Character details">
      <div class="result-heading">
        <div>
          <p class="eyebrow">STEP 3</p>
          <h2>Who She Is</h2>
          <p class="lede">The rest of the <a href={url('/rules/templates/')}>Gem Template</a>. Fields marked with a dot are needed before you submit.</p>
        </div>
      </div>
      <div id="detail-fields"></div>
    </section>

    <section class="result" id="submission" aria-label="Your submission">
      <div class="result-heading">
        <div>
          <p class="eyebrow">STEP 4</p>
          <h2>Your Submission</h2>
          <p class="lede">This is exactly what gets pasted into Discord. Staff still review every sheet.</p>
        </div>
        <div class="progress-box">
          <strong id="progress-count">0 / 0</strong>
          <span>needed fields filled</span>
        </div>
      </div>
      <div class="progress"><span id="progress-bar"></span></div>
      <ul class="checklist" id="checklist"></ul>
      <pre class="sheet-preview" id="sheet-preview"></pre>
      <div class="submit-row">
        <button id="copy-sheet" class="btn" type="button">⧉ Copy Submission</button>
        <span class="field-note" id="char-count"></span>
        <button id="finish-draft" class="mini-btn" type="button" disabled>I've submitted it, clear my draft</button>
      </div>
    </section>

    <section class="result ability-checker" id="abilities-check" aria-label="Ability overlap checker">
      <div class="result-heading">
        <div>
          <p class="eyebrow">TOOLS</p>
          <h2>Ability Checker</h2>
          <p class="lede">Type an ability name or what it does to see if a Gem-Type already has something like it.</p>
        </div>
      </div>
      <div class="ability-search-container">
        <label for="ability-search-input">Ability name or effect</label>
        <input id="ability-search-input" type="text" placeholder="e.g. 'Water Control' or 'healing'" />
        <button id="ability-search-btn">Search</button>
      </div>
      <div class="ability-results" id="ability-results">
        <p class="field-note">Enter an ability name to check it against every Gem-Type.</p>
      </div>
    </section>

    <section class="result submission-validator" id="sheet" aria-label="Character sheet checker">
      <div class="result-heading">
        <div>
          <p class="eyebrow">TOOLS</p>
          <h2>Sheet Checker</h2>
          <p class="lede">Already have a sheet? Paste a filled-in <a href={url('/rules/templates/')}>Gem Template</a>. It checks for missing fields, compares your stats and height to your Gem-Type, and checks your Facet &amp; Cut.</p>
        </div>
      </div>
      <div class="validator-input">
        <label for="character-sheet-input">Character sheet</label>
        <textarea id="character-sheet-input" rows="12" placeholder="Paste your sheet here"></textarea>
      </div>
      <button id="validate-btn" class="validate-btn">Check sheet</button>
      <div class="validation-results" id="validation-results">
        <p class="field-note">Paste your sheet above and press Check sheet.</p>
      </div>
    </section>
  </main>
  <script is:inline set:html={payload} />
  <script is:inline src={url('/gem-builder/app.js')}></script>
</Site>
