---
import Site from '../../layouts/Site.astro';
import { DIAMONDS, FORTHCOMING_DIAMONDS } from '../../lib/diamonds';
import { url } from '../../lib/gems';
const regentData = import.meta.glob('../../data/regents/*.json', { import: 'default', eager: true }) as Record<string, any>;
const regents = Object.fromEntries(Object.values(regentData).map((r: any) => [r.slug, r]));

// Every Diamond's Cubic Zirconia slots, in order. null = slot still open. Omega White's is left out on purpose.
const SLOTS: Record<string, (string | null)[]> = {
  'alpha-black': ['dante'],
  'theta-gold': ['ordr'],
  'epsilon-blue': ['tethys', 'law'],
  'saturn-light': ['florentino'],
  'nightshade-violet': ['reina', 'antton'],
  'maroon-red': ['magda', null],
  'bi-colored-kandy': ['cece', null],
};

// Pearl slots: every Diamond has 3, and every Cubic Zirconia has 1. Members can claim an open slot by
// submitting a Pearl for it. A string is a Pearl already in the slot; null is still open.
// A name ending in " *" is a claimable character: staff made the basics, and a member can claim and play them.
const DIAMOND_PEARLS: Record<string, (string | null)[]> = {
  'alpha-black': ['Seraph', 'Cherub', 'Ophan'],
  'maroon-red': ['Marion *'],
  'theta-gold': ['Golden Light Pearl *', 'Golden Canary Pearl *'],
};
const REGENT_PEARLS: Record<string, string | null> = {
  reina: 'Milo *',
  tethys: 'Cloud Pearl *',
};
const pearlsFor = (slug: string) => { const p = DIAMOND_PEARLS[slug] ?? []; return [0, 1, 2].map((i) => p[i] ?? null); };

// Glass colors for each Diamond's window: two glass tones, a dark tone, and the glow.
const GLASS: Record<string, { a: string; b: string; dark: string; glow: string }> = {
  'alpha-black': { a: '#2b3350', b: '#e8c46a', dark: '#0b0d18', glow: '#7fa8ff' },
  'omega-white': { a: '#e9ecf5', b: '#aab6cf', dark: '#5d6478', glow: '#f4f6ff' },
  'theta-gold': { a: '#f2c94c', b: '#ffe9a8', dark: '#7a5a12', glow: '#f2c94c' },
  'epsilon-blue': { a: '#3f7fe0', b: '#bfe3ff', dark: '#13305f', glow: '#7fb3ff' },
  'saturn-light': { a: '#e8a24a', b: '#ffd28a', dark: '#6b3a14', glow: '#ff9a5a' },
  'nightshade-violet': { a: '#7d4fc2', b: '#c9a8f0', dark: '#2a1544', glow: '#9b6bd6' },
  'maroon-red': { a: '#a3223a', b: '#ff8a5a', dark: '#40101a', glow: '#e0455a' },
  'bi-colored-kandy': { a: '#ff7ab8', b: '#6ec6ff', dark: '#3a2050', glow: '#ff9ad0' },
};

// How each picture sits in the glass. 'glass': the art has no background, so a glass mural shows behind it
// (src points at a cutout from scripts/glass_cutout.py when the original had a flat color behind it).
// 'paper': a sketch on paper, so the paper takes on the glass color. Anything not listed keeps its own background.
const ART: Record<string, { mode: 'glass' | 'paper'; src?: string; pos?: string }> = {
  'alpha-black': { mode: 'glass' },
  'theta-gold': { mode: 'paper' },
  'nightshade-violet': { mode: 'glass', src: '/images/glass/nightshade-violet.webp' },
  'maroon-red': { mode: 'glass', src: '/images/glass/maroon-red.webp' },
  'bi-colored-kandy': { mode: 'paper' },
  florentino: { mode: 'glass' },
  antton: { mode: 'glass' },
  reina: { mode: 'glass' },
  cece: { mode: 'glass', pos: '82% 40%' },
  magda: { mode: 'glass', pos: '50% 40%' },
  tethys: { mode: 'glass', src: '/images/glass/tethys.webp' },
};
const artSrc = (key: string, fallback: string) => url(ART[key]?.src ?? fallback);

// The hall's order: the four Deity Diamonds in the middle, and the Ruling Diamonds in rank order reading left to right (Nightshade, head of the Authority, first, then Maroon, Kandy and Saturn).
const HALL = ['nightshade-violet', 'maroon-red', 'theta-gold', 'alpha-black', 'omega-white', 'epsilon-blue', 'bi-colored-kandy', 'saturn-light'];
const bySlug = (s: string) => DIAMONDS.find((d) => d.slug === s)!;
const hall = HALL.map(bySlug).filter(Boolean);
const COURTS = [...DIAMONDS.filter((d) => d.group === 'deity'), ...DIAMONDS.filter((d) => d.group === 'ruling')];

// A small seeded random, so each window's glass pattern is the same on every build.
function rng(seed: string) {
  let h = 2166136261;
  for (const c of seed) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
  return () => ((h = Math.imul(h ^ (h >>> 15), 2246822507), h = Math.imul(h ^ (h >>> 13), 3266489909), (h ^= h >>> 16) >>> 0) / 4294967296);
}

// Cuts the window into jittered triangles of colored glass.
function mosaic(slug: string, height: number, opts: { seed?: string; width?: number; cell?: number; light?: boolean } = {}) {
  const r = rng(slug + (opts.seed ?? ''));
  const g = GLASS[slug];
  const W = opts.width ?? 200;
  const cell = opts.cell ?? 42;
  const cols = Math.max(2, Math.round(W / cell)), rows = Math.max(2, Math.round(height / cell));
  const pts: [number, number][][] = [];
  for (let y = 0; y <= rows; y++) {
    pts.push([]);
    for (let x = 0; x <= cols; x++) {
      const edgeX = x === 0 || x === cols, edgeY = y === 0 || y === rows;
      const px = (x / cols) * W + (edgeX ? 0 : (r() - 0.5) * cell * 0.62);
      const py = (y / rows) * height + (edgeY ? 0 : (r() - 0.5) * cell * 0.52);
      pts[y].push([Math.round(px), Math.round(py)]);
    }
  }
  const palette = opts.light ? [g.b, g.a, g.b, g.b, g.a, '#ffffff'] : [g.a, g.a, g.b, g.dark, g.a, g.b];
  const tris: { d: string; fill: string; op: number }[] = [];
  for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
    const [p1, p2, p3, p4] = [pts[y][x], pts[y][x + 1], pts[y + 1][x + 1], pts[y + 1][x]];
    const flip = r() > 0.5;
    const a = flip ? [p1, p2, p3] : [p1, p2, p4];
    const b = flip ? [p1, p3, p4] : [p2, p3, p4];
    for (const t of [a, b]) tris.push({ d: `M${t.map((p) => p.join(',')).join('L')}Z`, fill: palette[Math.floor(r() * palette.length)], op: opts.light ? 0.22 + r() * 0.3 : 0.55 + r() * 0.4 });
  }
  return tris;
}

// The same glass as a standalone picture, for CSS backgrounds behind the court art and Regent panes.
function muralURI(slug: string, w: number, h: number, seed: string, paper = false) {
  const g = GLASS[slug];
  const tris = mosaic(slug, h, { seed, width: w, cell: paper ? 52 : 30, light: true });
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${w} ${h}' preserveAspectRatio='none'><rect width='${w}' height='${h}' fill='${paper ? '#f4efe6' : g.dark}'/><radialGradient id='h' cx='.5' cy='.38' r='.55'><stop offset='0' stop-color='${g.b}' stop-opacity='.55'/><stop offset='1' stop-color='${g.b}' stop-opacity='0'/></radialGradient>${tris.map((t) => `<path d='${t.d}' fill='${t.fill}' fill-opacity='${t.op.toFixed(2)}' stroke='%230c0913' stroke-opacity='${paper ? 0.15 : 1}' stroke-width='2'/>`).join('')}<rect width='${w}' height='${h}' fill='url(%23h)'/></svg>`;
  return `url("data:image/svg+xml,${svg.replace(/#/g, '%23').replace(/"/g, "'").replace(/</g, '%3C').replace(/>/g, '%3E')}")`;
}
const stripURI = (slug: string) => {
  const g = GLASS[slug];
  const tris = mosaic(slug, 14, { seed: 'strip', width: 600, cell: 16 });
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 14' preserveAspectRatio='none'><rect width='600' height='14' fill='${g.dark}'/>${tris.map((t) => `<path d='${t.d}' fill='${t.fill}' fill-opacity='${t.op.toFixed(2)}' stroke='%230c0913' stroke-width='1.4'/>`).join('')}</svg>`;
  return `url("data:image/svg+xml,${svg.replace(/#/g, '%23').replace(/</g, '%3C').replace(/>/g, '%3E')}")`;
};

const tall = (d: any) => (d.group === 'deity' ? 460 : 380);
const windows = hall.map((d) => {
  const H = tall(d);
  return {
    d, H, g: GLASS[d.slug],
    tris: mosaic(d.slug, H),
    mural: ART[d.slug] ? mosaic(d.slug, H, { seed: 'mural', cell: ART[d.slug].mode === 'paper' ? 46 : 26, light: true }) : [],
    lead: ART[d.slug]?.mode === 'paper' ? 0.16 : 1,
    art: ART[d.slug],
    outer: `M0,${H} L0,100 A100,100 0 0 1 200,100 L200,${H} Z`,
    inner: `M26,${H - 26} L26,110 A74,74 0 0 1 174,110 L174,${H - 26} Z`,
  };
});
// Long quotes are cut at a sentence so the court banner stays short. The full quote is on the Diamond's page.
function shortQuote(q: string) {
  const t = q.trim().replace(/^"|"$/g, '');
  if (t.length <= 170) return `“${t}”`;
  let cut = '';
  for (const part of t.match(/[^.!?]+[.!?]+/g) ?? [t]) { if ((cut + part).length > 170) break; cut += part; }
  return `“${(cut || t.slice(0, 160)).trim()} …”`;
}
const regentArt = (r: any) => r.art.src.replace('{{BASE}}', url('/'));
const regentCourt = (r: any) => r.facts.find((f: any) => f[0] === 'Court')?.[1];
---

<Site title="Know Your Diamond" description="Rank 1.1: the Diamonds of the Gempire, and the Grand Regents of each court." current="diamonds">
  <div class="hall">
    <div class="hall-light" aria-hidden="true"></div>
    <header class="hall-head wrap">
      <p class="crumbs"><a href={url('/lore/overview/')}>Lore</a> <span>/</span> Rank 1.1</p>
      <h1>Know Your Diamond</h1>
      <p class="intro">The Diamonds founded the Gempire and made the first of its Gems. Choose a window to visit their court.</p>
      <div class="ornament" aria-hidden="true">◈</div>
    </header>

    <nav class="windows" aria-label="The Diamonds">
      {windows.map((w) => (
        <a class={`win ${w.d.group}`} href={`#court-${w.d.slug}`} style={`--glow:${w.g.glow};--wa:${w.g.a};--wb:${w.g.b}`}>
          <svg viewBox={`0 0 200 ${w.H}`} role="img" aria-label={w.d.name}>
            <defs>
              <clipPath id={`o-${w.d.slug}`}><path d={w.outer} /></clipPath>
              <clipPath id={`i-${w.d.slug}`}><path d={w.inner} /></clipPath>
              <radialGradient id={`h-${w.d.slug}`}><stop offset="0" stop-color="#fff8e8" stop-opacity="0.5" /><stop offset="1" stop-color={w.g.b} stop-opacity="0" /></radialGradient>
              <linearGradient id={`t-${w.d.slug}`} x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color={w.g.b} stop-opacity="0.35" />
                <stop offset="0.45" stop-color={w.g.a} stop-opacity="0.08" />
                <stop offset="1" stop-color={w.g.dark} stop-opacity="0.45" />
              </linearGradient>
            </defs>
            <g clip-path={`url(#o-${w.d.slug})`}>
              <rect width="200" height={w.H} fill={w.g.dark} />
              {w.tris.map((t) => <path d={t.d} fill={t.fill} fill-opacity={t.op} stroke="#0c0913" stroke-width="2.6" stroke-linejoin="round" />)}
            </g>
            <path d={w.inner} fill={w.art?.mode === 'paper' ? '#f4efe6' : w.art ? w.g.dark : '#06040b'} />
            <g clip-path={`url(#i-${w.d.slug})`} style="isolation:isolate">
              {w.art && <>
                {w.mural.map((t) => <path d={t.d} fill={t.fill} fill-opacity={t.op} stroke="#0c0913" stroke-opacity={w.lead} stroke-width="1.6" stroke-linejoin="round" />)}
                <ellipse cx="100" cy={Math.round(w.H * 0.36)} rx="70" ry={Math.round(w.H * 0.3)} fill={`url(#h-${w.d.slug})`} />
              </>}
              <image href={artSrc(w.d.slug, w.d.art)} x="26" y="36" width="148" height={w.H - 62} preserveAspectRatio="xMidYMin slice" style={w.art?.mode === 'paper' ? 'mix-blend-mode:multiply' : undefined} />
              <rect width="200" height={w.H} fill={`url(#t-${w.d.slug})`} />
            </g>
            <path d={w.inner} fill="none" stroke="#0c0913" stroke-width="6" />
            <path d={w.inner} fill="none" stroke={w.g.b} stroke-width="1.4" stroke-opacity="0.7" transform="translate(0 0)" />
            <path d={w.outer} fill="none" stroke="#0c0913" stroke-width="8" />
          </svg>
          <span class="plate">
            <strong>{w.d.name.replace(' Diamond', '')}</strong>
            <small>{w.d.pillar ? `Pillar of ${w.d.pillar}` : w.d.domains.join(' & ')}</small>
          </span>
        </a>
      ))}
    </nav>
    <p class="legend wrap"><span>The tall windows are the four Deity Diamonds. The rest are the Ruling Diamonds.</span></p>
  </div>

  <main class="wrap courts">
    <p class="intro muted">
      Each Diamond's court is below, with their Grand Regents, the Cubic Zirconias who emerged beside them as siblings. Pages marked Partial only have what the server already knows.
    </p>

    {COURTS.map((d) => {
      const g = GLASS[d.slug];
      const slots = SLOTS[d.slug] ?? [];
      return (
        <section class="court" id={`court-${d.slug}`} style={`--wa:${g.a};--wb:${g.b};--wd:${g.dark};--glow:${g.glow};--strip:${stripURI(d.slug)}`}>
          <a class={`court-art${ART[d.slug] ? ` on-glass ${ART[d.slug].mode}` : ''}`} href={url(`/diamonds/${d.slug}/`)} style={ART[d.slug] ? `background-image:${muralURI(d.slug, 260, 380, 'court', ART[d.slug].mode === 'paper')}` : undefined}>
            <img src={artSrc(d.slug, d.art)} alt={`${d.name} art`} loading="lazy" />
          </a>
          <div class="court-body">
            <p class="court-kicker">{d.group === 'deity' ? 'Deity Diamond' : 'Ruling Diamond'} · Court {d.court}</p>
            <h2><a href={url(`/diamonds/${d.slug}/`)}>{d.name}</a>{(d.status || d.partial) && <span class="tag">{d.status ?? 'Partial'}</span>}</h2>
            <dl class="facts">
              {d.pillar && <div><dt>Pillar</dt><dd>{d.pillar}</dd></div>}
              {d.domains.length > 0 && <div><dt>{d.domains.length > 1 ? 'Domains' : 'Domain'}</dt><dd>{d.domains.join(' and ')}</dd></div>}
              {d.height && <div><dt>Height</dt><dd>{d.height}</dd></div>}
              <div><dt>Color</dt><dd>{d.color}</dd></div>
            </dl>
            {d.quote && <blockquote class="court-quote">{shortQuote(d.quote)}</blockquote>}
            <a class="court-link" href={url(`/diamonds/${d.slug}/`)}>Visit {d.name.replace(' Diamond', '')}'s page ›</a>
          </div>

          {slots.length > 0 && <div class="court-regents">
              <h3 class="regents-head">Grand Regents<span>{slots.length === 1 ? '1 Cubic Zirconia' : `${slots.length} Cubic Zirconias`}</span></h3>
              <div class="regents">
                {slots.map((rs, i) => {
                  const r = rs ? regents[rs] : null;
                  if (!r) return (
                    <div class="pane open">
                      <div class="pane-glass"><span aria-hidden="true">+</span></div>
                      <strong>Seat open</strong>
                      <small>Cubic Zirconia {i + 1}</small>
                    </div>
                  );
                  if (r.pending) return (
                    <a class={`pane${r.redacted ? ' sealed' : ''}`} href={url(`/regents/${r.slug}/`)}>
                      <div class="pane-glass">
                        <svg viewBox="0 0 100 130" aria-hidden="true"><circle cx="50" cy="40" r="19" /><path d="M16 130 C16 92 31 70 50 70 C69 70 84 92 84 130 Z" /></svg>
                        {r.redacted && <em>[REDACTED]</em>}
                      </div>
                      <strong>{r.name}</strong>
                      <small>{r.status}</small>
                    </a>
                  );
                  if (!r.art && !ART[r.slug]?.src) return (
                    <a class="pane" href={url(`/regents/${r.slug}/`)}>
                      <div class="pane-glass">
                        <svg viewBox="0 0 100 130" aria-hidden="true"><circle cx="50" cy="40" r="19" /><path d="M16 130 C16 92 31 70 50 70 C69 70 84 92 84 130 Z" /></svg>
                      </div>
                      <strong>{r.name}</strong>
                      <small>{r.facts[0][1]}</small>
                    </a>
                  );
                  return (
                    <a class="pane" href={url(`/regents/${r.slug}/`)}>
                      <div class={`pane-glass${ART[r.slug] ? ` on-glass ${ART[r.slug].mode}` : ''}`} style={ART[r.slug] ? `background-image:${muralURI(d.slug, 132, 185, r.slug)}` : undefined}><img src={ART[r.slug]?.src ? url(ART[r.slug].src!) : regentArt(r)} alt={`${r.name} art`} loading="lazy" style={ART[r.slug]?.pos ? `object-position:${ART[r.slug].pos}` : undefined} /></div>
                      <strong>{r.name}</strong>
                      <small>{r.facts[0][1]}</small>
                    </a>
                  );
                })}
              </div>
          </div>}

          {d.slug !== 'omega-white' && <div class="court-pearls">
            <h3 class="regents-head">Pearls<span>3 for the Diamond · 1 for each Cubic Zirconia</span></h3>
            <ul class="pearls">
              {pearlsFor(d.slug).map((p, i) => (
                <li class={p ? (p.endsWith(' *') ? 'pearl claim' : 'pearl') : 'pearl open'}><i aria-hidden="true"></i><b>{p ? p.replace(/ \*$/, '') : 'Open'}{p?.endsWith(' *') && <em>Claimable</em>}</b><small>{d.name.replace(' Diamond', '')}'s Pearl {i + 1}</small></li>
              ))}
              {slots.filter((rs): rs is string => !!rs && !!regents[rs]).map((rs) => {
                const p = REGENT_PEARLS[rs] ?? null;
                return <li class={p ? (p.endsWith(' *') ? 'pearl claim' : 'pearl') : 'pearl open'}><i aria-hidden="true"></i><b>{p ? p.replace(/ \*$/, '') : 'Open'}{p?.endsWith(' *') && <em>Claimable</em>}</b><small>{regents[rs].redacted ? 'A Regent' : regents[rs].name.replace(/^Grand Regent /, '')}'s Pearl</small></li>;
              })}
            </ul>
          </div>}
        </section>
      );
    })}

    {FORTHCOMING_DIAMONDS.length > 0 && <section class="panel">
      <div class="bar">Forthcoming</div>
      <div class="body">
        <p>These Diamonds are known, and their submissions have not arrived yet. Their pages will be added when they do.</p>
        <ul class="forthcoming">
          {FORTHCOMING_DIAMONDS.map((d) => <li><strong>{d.name}</strong> &middot; {d.note}</li>)}
        </ul>
      </div>
    </section>}
  </main>
</Site>

<style>
  /* ---- The hall of windows ---- */
  .hall { position: relative; overflow: hidden; padding: 1.6rem 0 1.2rem; background:
      radial-gradient(ellipse 70% 55% at 50% 30%, rgba(124, 77, 255, 0.12), transparent 70%),
      linear-gradient(180deg, #07050d 0%, #0c0818 55%, #07050d 100%);
    border-bottom: 1px solid var(--line); }
  .hall-light { position: absolute; inset: 0; pointer-events: none; background:
      repeating-linear-gradient(100deg, transparent 0 9%, rgba(255, 240, 210, 0.025) 9% 11%, transparent 11% 13%);
    mask-image: linear-gradient(180deg, transparent 20%, #000 60%, transparent 100%); }
  .hall-head { position: relative; text-align: center; }
  .hall-head .intro { margin: 0 auto; }
  .ornament { display: flex; align-items: center; justify-content: center; gap: 0.8rem; margin: 1rem auto 0; color: #c9b8ff; opacity: 0.7; }
  .ornament::before, .ornament::after { content: ''; width: min(140px, 20vw); height: 1px; background: linear-gradient(90deg, transparent, currentColor); }
  .ornament::after { transform: scaleX(-1); }
  .windows::before { content: ''; position: absolute; left: -10%; right: -10%; bottom: 2.1rem; height: 1px; background: linear-gradient(90deg, transparent, rgba(201, 184, 255, 0.35), transparent); }
  .crumbs { color: var(--muted); font-size: 0.8rem; letter-spacing: 0.06em; margin: 0 0 0.8rem; }
  .crumbs span { margin: 0 0.3rem; }
  h1 { margin: 0 0 0.6rem; font-size: 2.2rem; letter-spacing: 0.02em; }
  .intro { max-width: 62ch; color: #ddd5f5; }
  .intro.muted { color: var(--muted); font-size: 0.92rem; }

  .windows { position: relative; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); align-items: end; gap: clamp(0.4rem, 1.2vw, 1.1rem);
    max-width: 1240px; margin: 2rem auto 0; padding: 0 1.2rem; }
  .win { display: flex; flex-direction: column; align-items: center; text-decoration: none; color: var(--text); }
  .win svg { width: 100%; height: auto; display: block; filter: drop-shadow(0 0 14px color-mix(in srgb, var(--glow) 45%, transparent)) brightness(0.92);
    transition: filter 0.25s ease, transform 0.25s ease; }
  .win:hover svg, .win:focus-visible svg { filter: drop-shadow(0 0 26px var(--glow)) brightness(1.1); transform: translateY(-4px); }
  .win::after { content: ''; width: 120%; height: 34px; margin-top: -6px; background: radial-gradient(ellipse at 50% 0, color-mix(in srgb, var(--glow) 35%, transparent), transparent 70%); pointer-events: none; }
  .plate { order: 3; margin-top: -20px; text-align: center; line-height: 1.2; }
  .plate strong { display: block; font-family: var(--serif); font-weight: 400; font-size: clamp(0.78rem, 1.1vw, 1rem); }
  .plate small { display: block; margin-top: 0.15rem; color: var(--muted); font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .legend { margin-top: 1rem; text-align: center; color: var(--muted); font-size: 0.78rem; }

  /* ---- The courts ---- */
  .courts { padding-top: 1.6rem; }
  .court { position: relative; display: grid; grid-template-columns: minmax(180px, 240px) minmax(0, 1fr) auto; align-items: start; gap: 1.8rem; margin: 1.8rem 0; padding: 1.9rem 1.5rem 1.5rem;
    border: 1px solid color-mix(in srgb, var(--wa) 45%, transparent); border-radius: 14px; scroll-margin-top: 80px;
    background: linear-gradient(120deg, color-mix(in srgb, var(--wd) 70%, #07050d) 0%, #0a0712 55%, #07050d 100%); overflow: hidden; }
