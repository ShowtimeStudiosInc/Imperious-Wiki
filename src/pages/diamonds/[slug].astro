---
/**
 * Diamond pages. Every Diamond uses the same layout (based on Saturn Light's
 * design, styles in src/styles/diamond-page.css). What differs per Diamond:
 *  - text: src/data/diamond-pages/<slug>.json
 *  - theme: src/diamond-pages/themes/<slug>.html (font links, color variables,
 *    the moving background and its script, and the hero mark between
 *    <!--mark--> markers)
 *  - facts and chips: src/lib/diamonds.ts
 * These pages don't load the site's shared CSS. They carry their own copy of
 * the top menu. {{BASE}} in data or theme files becomes the site base path.
 */
import '../../styles/diamond-page.css';
import { DIAMONDS } from '../../lib/diamonds';
import { url } from '../../lib/gems';

const themes = import.meta.glob('../../diamond-pages/themes/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const pages = import.meta.glob('../../data/diamond-pages/*.json', { import: 'default', eager: true }) as Record<string, any>;
const regentData = import.meta.glob('../../data/regents/*.json', { import: 'default', eager: true }) as Record<string, any>;

export async function getStaticPaths() {
  return DIAMONDS.map((d) => ({ params: { slug: d.slug }, props: { diamond: d } }));
}
const { diamond: d } = Astro.props;
const base = url('/');
const fix = (s: string) => (s ?? '').replaceAll('{{BASE}}', base);
const themeRaw = themes[`../../diamond-pages/themes/${d.slug}.html`];
const p = pages[`../../data/diamond-pages/${d.slug}.json`];
if (!themeRaw || !p) throw new Error(`Missing theme or data for ${d.slug}`);
const theme = fix(themeRaw);
const fonts = theme.match(/<!--fonts-->([\s\S]*?)<!--\/fonts-->/)?.[1] ?? '';
const mark = theme.match(/<!--mark-->([\s\S]*?)<!--\/mark-->/)?.[1] ?? '';
const background = theme.replace(/<!--fonts-->[\s\S]*?<!--\/fonts-->/, '').replace(/<!--mark-->[\s\S]*?<!--\/mark-->/, '');

const regents = Object.values(regentData).filter((r: any) => r.diamond === d.slug);
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const pronouns = d.pronouns.split('/').map((x) => x.trim()).join(' / ');
const domains = d.domains.join(' & ');
const images = p.art.images.map((i: any) => ({ ...i, src: fix(i.src), full: fix(i.full) }));
const single = images.length === 1;
const TBD = 'To come';
const or = (v: string) => (v && String(v).trim() ? v : TBD);
const powerList: { name: string; level: string }[] = p.abilities.length ? p.abilities : (p.powerList ?? []);
const tbdText = 'Not known yet. This will be filled in once the submission is in.';
const jump = [
  { id: 'appearance', label: 'Appearance' },
  { id: 'personality', label: 'Personality' },
  { id: 'purpose', label: 'Purpose' },
  { id: 'powers', label: 'Powers' },
  ...p.abilities.map((a: any) => ({ id: slugify(a.name), label: a.name })),
];
const facts: [string, string][] = [
  ['Pronouns', pronouns],
  ['Height', or(d.height)],
  ['Color', or(d.color)],
  ...(d.pillar ? [['Pillar of', d.pillar] as [string, string]] : []),
  ['Domains', domains],
  ['Sub-Domains', or(d.subDomains.join(', '))],
  ['Court', or(d.court)],
  ['Powers', powerList.length ? powerList.map((a: any) => `${a.name} [${a.level}]`).join('<br />') : TBD],
];

const title = `${d.name} | Imperious Authorities`;
const desc = `${d.name}${d.pillar ? `, Pillar of ${d.pillar}` : ''}. ${d.purpose}`.slice(0, 200);
const ogImage = new URL(url(d.art || '/images/brand/og-logo.png'), Astro.site).href;
const nav = [
  { href: '/gem-types/', label: 'Gem-Types', key: 'gem-types' },
  { href: '/diamonds/', label: 'Diamonds', key: 'diamonds' },
  { href: '/start-here/welcome/', label: 'Start Here', key: 'start' },
  { href: '/rules/overview/', label: 'Rules', key: 'rules' },
  { href: '/lore/overview/', label: 'Lore', key: 'lore' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#7c4dff" />
    <link rel="icon" href={url('/favicon.png')} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Inter:wght@400;500;600&display=swap" />
    <Fragment set:html={fonts} />
    <style is:inline>
      .ia-top { position: sticky; top: 0; z-index: 1000; display: flex; align-items: center; gap: 1.25rem;
        padding: 0.7rem 1.25rem; background: rgba(7, 5, 13, 0.82); backdrop-filter: blur(8px);
        border-bottom: 1px solid rgba(201, 184, 255, 0.16); font-family: Inter, system-ui, sans-serif; line-height: 1.55; }
      .ia-top a { text-decoration: none; }
      .ia-top .ia-brand { font-family: 'Libre Baskerville', Georgia, serif; font-size: 1.02rem; letter-spacing: 0.04em; color: #ece6ff; display: flex; align-items: center; gap: 0.5rem; }
      .ia-top .ia-brand img { height: 1.6rem; width: auto; display: block; }
      .ia-top nav { display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.86rem; letter-spacing: 0.06em; text-transform: uppercase; }
      .ia-top nav a { color: #a99fc7; }
      .ia-top nav a:hover, .ia-top nav a[aria-current] { color: #ece6ff; }
      @media (max-width: 700px) {
        .ia-top { flex-wrap: wrap; gap: 0.4rem 1rem; padding: 0.6rem 0.9rem; }
        .ia-top nav { gap: 0.8rem; font-size: 0.74rem; }
      }
    </style>
  </head>
  <body>
    <header class="ia-top">
      <a class="ia-brand" href={url('/')}><img src={url('/images/brand/logo-white.png')} alt="" width="22" height="27" /> Imperious Authorities</a>
      <nav aria-label="Main">
        {nav.map((n) => <a href={url(n.href)} aria-current={n.key === 'diamonds' ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </header>

    <Fragment set:html={background} />

    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={url('/')}>Imperious Authorities Wiki</a><span class="sep">/</span>
        <a href={url('/diamonds/')}>Know Your Diamond</a><span class="sep">/</span>
        <span>{d.name}</span>
      </nav>

      <header class="hero">
        <Fragment set:html={mark} />
        <div class="court-line">{p.courtLine}</div>
        <h1 set:html={p.title} />
        <p class="hero-sub" set:html={p.heroSub} />
        {p.partial && <p class="partial-note">{p.partial}</p>}
        {p.quote && (
          <blockquote class="quote">
            <p set:html={`&ldquo;${p.quote}&rdquo;`} />
            <footer>{p.quoteBy}</footer>
          </blockquote>
        )}
        <div class="domain-chips">
          <span><b>Domains</b>{or(domains)}</span>
          <span><b>Color</b>{or(d.color)}</span>
          <span><b>Height</b>{or(d.height)}</span>
          <span><b>Pronouns</b>{or(pronouns)}</span>
        </div>
      </header>

      <nav class="jumpnav" aria-label="On this page">
        {jump.map((j) => <a href={`#${j.id}`}>{j.label}</a>)}
      </nav>

      <div class="grid">
        <main class="stack">
          <section class="card" id="personality">
            <h2><span class="dot"></span>Personality</h2>
            {p.personality.length ? p.personality.map((t: string) => <p set:html={t} />) : <p class="tbd">{tbdText}</p>}
          </section>
          <section class="card" id="purpose">
            <h2><span class="dot"></span>Purpose</h2>
            {p.purpose.length ? p.purpose.map((t: string) => <p set:html={t} />) : <p class="tbd">{tbdText}</p>}
          </section>
          <section class="card" id="powers">
            <h2><span class="dot"></span>Powers</h2>
            <ul class="powers-list">
              {powerList.map((a: any) => <li>{a.name} <span class="level">{a.level}</span></li>)}
            </ul>
            {!powerList.length && <p class="tbd">{tbdText}</p>}
            <div class="weak-box">
              <h3>Weakness</h3>
              {p.weakness.length ? p.weakness.map((t: string) => <p set:html={t} />) : <p class="tbd">{tbdText}</p>}
            </div>
          </section>

          {p.abilities.map((a: any, i: number) => (
            <section class="card ability" id={slugify(a.name)}>
              <div class="ability-head">
                <div class="num">Ability {i + 1} <span class="level">{a.level}</span></div>
                <h2>{a.name}</h2>
                <div class="meta">
                  {Object.entries(a.meta).map(([k, v]) => <span>{k}<b>{v as string}</b></span>)}
                </div>
              </div>
              <div class="ability-body">
                {a.desc.map((t: string) => <p set:html={t} />)}
                {a.passives.length > 0 && <h3 class="subhead">{a.passives.length > 1 ? 'Passives' : 'Passive'}</h3>}
                {a.passives.length > 0 && (
                  <div class="passives">
                    {a.passives.map((ps: any) => (
                      <div class="passive"><h4>{ps.name}</h4><p set:html={ps.text} /></div>
                    ))}
                  </div>
                )}
                <h3 class="subhead">Spells</h3>
                <ul class="spells">
                  {a.spells.map((s: any) => (
                    <li>
                      <div><span class="spell-name">{s.name}</span><span class="spell-tier">{s.tier}</span></div>
                      <p class="spell-desc" set:html={s.text} />
                      <span class="sp-cost">{s.cost}</span>
                    </li>
                  ))}
                </ul>
                {a.weak && (
                  <div class="weak-box">
                    <h3>{a.weakLabel}</h3>
                    <p set:html={a.weak} />
                  </div>
                )}
              </div>
            </section>
          ))}
        </main>

        <aside>
          <section class="artbox" id="appearance">
            <div class="artbox-head">
              <h2>Appearance</h2>
              {p.art.sub && <p>{p.art.sub}</p>}
            </div>
            {images.length === 0 && (
              <div class="collage single"><figure class="noart"><img src={url(d.art)} alt="" /></figure></div>
            )}
            {images.length > 0 && <div class={`collage${single ? ' single' : ''}`}>
              {images.map((im: any) => (
                <figure data-full={im.full} data-title={im.title} data-note={im.note} tabindex="0" role="button" aria-label={`View ${im.title} picture larger`}>
                  <img src={im.src} alt={im.alt} loading="lazy" />
                  {!single && <figcaption>{im.title}</figcaption>}
                </figure>
              ))}
            </div>}
            {images.length > 1 && (
              <div class="collage-notes">
                {images.map((im: any) => <div><b>{im.title}:</b> {im.note}</div>)}
              </div>
            )}
          </section>

          <section class="facts-wrap" aria-label={`${d.name} facts`}>
            <h2>At a glance</h2>
            <table class="facts">
              {facts.map(([k, v]) => <tr><th>{k}</th><td set:html={v} /></tr>)}
            </table>
          </section>

          {regents.length > 0 && (
            <section class="facts-wrap" aria-label="Grand Regents">
              <h2>{regents.length > 1 ? 'Grand Regents' : 'Grand Regent'}</h2>
              <ul class="credits">
                {regents.map((r: any) => <li><a href={url(`/regents/${r.slug}/`)}>{r.name}</a></li>)}
              </ul>
            </section>
          )}

          {p.credits.length > 0 && (
            <section class="facts-wrap" aria-label="Art credits">
              <h2>Art Credits</h2>
              <ul class="credits">
                {p.credits.map((c: any) => <li><b>{c.label}:</b>{c.name}</li>)}
              </ul>
            </section>
          )}
        </aside>
      </div>
    </div>

    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Picture viewer">
      <button class="lb-close" id="lbClose" aria-label="Close picture viewer">&times;</button>
      <figure>
        <img id="lbImg" alt="" />
        <figcaption><span id="lbTitle"></span><small id="lbNote"></small></figcaption>
      </figure>
    </div>

    <script is:inline>
      (function () {
        var lb = document.getElementById('lightbox');
        var lbImg = document.getElementById('lbImg');
        var lbTitle = document.getElementById('lbTitle');
        var lbNote = document.getElementById('lbNote');
        var lastFocus = null;
        function openLB(fig) {
          lastFocus = document.activeElement;
          lbImg.src = fig.getAttribute('data-full');
          lbImg.alt = fig.querySelector('img').alt;
          lbTitle.textContent = fig.getAttribute('data-title');
          lbNote.textContent = fig.getAttribute('data-note');
          lb.classList.add('open');
          document.getElementById('lbClose').focus();
        }
        function closeLB() {
          lb.classList.remove('open');
          lbImg.removeAttribute('src');
          if (lastFocus) lastFocus.focus();
        }
        document.querySelectorAll('.collage figure').forEach(function (fig) {
          fig.addEventListener('click', function () { openLB(fig); });
          fig.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLB(fig); }
          });
        });
        document.getElementById('lbClose').addEventListener('click', closeLB);
        lb.addEventListener('click', function (e) { if (e.target === lb) closeLB(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && lb.classList.contains('open')) closeLB(); });
      })();
    </script>
  </body>
</html>
