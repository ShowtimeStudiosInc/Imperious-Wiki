        <div class="gear g2" data-depth="0.7"><svg viewBox="0 0 100 100"><g><rect x="46" y="4" width="8" height="16" rx="2" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(45 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(90 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(135 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(180 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(225 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(270 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(315 50 50)" /><circle cx="50" cy="50" r="28" /><circle cx="50" cy="50" r="10" /></g></svg></div>
        <div class="gear g3" data-depth="1.1"><svg viewBox="0 0 100 100"><g><rect x="46" y="4" width="8" height="16" rx="2" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(45 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(90 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(135 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(180 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(225 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(270 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(315 50 50)" /><circle cx="50" cy="50" r="28" /><circle cx="50" cy="50" r="10" /></g></svg></div>
        <div class="gear g4" data-depth="0.5"><svg viewBox="0 0 100 100"><g><rect x="46" y="4" width="8" height="16" rx="2" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(45 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(90 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(135 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(180 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(225 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(270 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(315 50 50)" /><circle cx="50" cy="50" r="28" /><circle cx="50" cy="50" r="10" /></g></svg></div>
        <div class="gear g5" data-depth="1.4"><svg viewBox="0 0 100 100"><g><rect x="46" y="4" width="8" height="16" rx="2" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(45 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(90 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(135 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(180 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(225 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(270 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(315 50 50)" /><circle cx="50" cy="50" r="28" /><circle cx="50" cy="50" r="10" /></g></svg></div>
        <div class="gear g6" data-depth="0.9"><svg viewBox="0 0 100 100"><g><rect x="46" y="4" width="8" height="16" rx="2" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(45 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(90 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(135 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(180 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(225 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(270 50 50)" /><rect x="46" y="4" width="8" height="16" rx="2" transform="rotate(315 50 50)" /><circle cx="50" cy="50" r="28" /><circle cx="50" cy="50" r="10" /></g></svg></div>
      </div>
    )}
    {t.meteors && (
      <div class="space-bg" aria-hidden="true">
        <div class="stars2" />
        <div class="meteor m1" data-depth="0.3"><svg viewBox="0 0 100 80"><polygon points="18,52 34,22 62,12 88,30 82,58 58,74 30,68" /></svg></div>
        <div class="meteor m2" data-depth="0.7"><svg viewBox="0 0 100 80"><polygon points="22,48 40,18 70,16 90,38 76,62 44,70" /></svg></div>
        <div class="meteor m3" data-depth="1.1"><svg viewBox="0 0 100 80"><polygon points="16,44 30,16 58,10 84,28 78,56 52,72 26,62" /></svg></div>
        <div class="meteor m4" data-depth="0.5"><svg viewBox="0 0 100 80"><polygon points="20,50 38,20 66,14 88,34 80,60 56,72 28,66" /></svg></div>
        <div class="meteor m5" data-depth="1.4"><svg viewBox="0 0 100 80"><polygon points="24,46 42,20 68,18 86,40 72,64 46,68" /></svg></div>
        <div class="meteor m6" data-depth="0.9"><svg viewBox="0 0 100 80"><polygon points="18,52 36,24 64,14 86,32 80,58 54,74 30,66" /></svg></div>
        <div class="meteor m7" data-depth="0.2"><svg viewBox="0 0 100 80"><polygon points="22,48 44,18 72,20 88,42 74,62 42,70" /></svg></div>
      </div>
    )}

    <div class="diamond-content">
      <p class="crumbs"><a href={url('/diamonds/')}>Know Your Diamond</a> <span>/</span> Rank 1.1</p>

      <section class="panel hero">
        <div class="hero-art">
          {d.references ? (
            <div class="collage">
              {d.references.map((r) => (
                <figure>
                  <img src={url(r.image)} alt={`${d.name}: ${r.label}`} />
                  <figcaption>{r.label} &middot; {r.caption}</figcaption>
                </figure>
              ))}
            </div>
          ) : (
            <img src={url(d.art)} alt={`${d.name} art`} />
          )}
        </div>
        <div class="hero-body">
          <p class="eyebrow">Rank 1.1{d.pillar ? ` · Pillar of ${d.pillar}` : ''}</p>
          <h1>{d.name}</h1>
          <p class="domains">Domains: {d.domains.join(' and ')}</p>
          <div class="chips">
            <span class="chip">Court {d.court}</span>
            <span class="chip">Height {d.height}</span>
            <span class="chip">{d.pronouns}</span>
          </div>
          <dl class="facts">
            <dt>Color</dt><dd>{d.color}</dd>
            {d.pillar && <><dt>Pillar of</dt><dd>{d.pillar}</dd></>}
            <dt>Domains</dt><dd>{d.domains.join(', ')}</dd>
          </dl>
          {d.artCaption && <p class="bg-note">{d.artCaption}</p>}
          <p class="subdomains"><strong>Sub-Domains:</strong> {d.subDomains.join(', ')}</p>
        </div>
      </section>

      <blockquote class="quote">
        <p>&ldquo;{d.quote}&rdquo;</p>
      </blockquote>

      <div class="cols">
        <div class="col">
          <section class="panel">
            <div class="bar">Personality</div>
            <div class="body prose"><p>{d.personality}</p></div>
          </section>

          <section class="panel">
            <div class="bar">Purpose</div>
            <div class="body prose"><p>{d.purpose}</p></div>
          </section>

          <section class="panel">
            <div class="bar">Powers</div>
            <div class="body">
              <ul class="power-list">
                {d.powers.map((p) => (
                  <li><strong>{p.name}</strong> <span class="level">[{p.level}]</span></li>
                ))}
              </ul>
            </div>
          </section>

          <section class="panel">
            <div class="bar">Weakness</div>
            <div class="body prose"><p>{d.weaknesses}</p></div>
          </section>
        </div>

        <div class="col">
          {d.abilities.map((a) => (
            <section class="panel ability">
              <div class="bar">{a.name}</div>
              <div class="body">
                <dl class="facts">
                  <dt>Parent Ability</dt><dd>{a.parent}</dd>
                  <dt>Complexity</dt><dd>{a.complexity}</dd>
                  <dt>Level</dt><dd>{a.level}</dd>
                  <dt>Origin</dt><dd>{a.origin}</dd>
                </dl>
                <p class="prose">{a.description}</p>
                <h3>Passives</h3>
                {a.passives.map((p) => (
                  <p class="passive"><strong>{p.name}:</strong> <span set:html={rich(p.text)} /></p>
                ))}
                <h3>Spells</h3>
                {a.spells.map((s) => (
                  <article class="spell">
                    <header>
                      <span class="sname">{s.name}</span>
                      <span class="stag cost">{s.cost} SP</span>
                      <span class="stag">{s.kind}</span>
                    </header>
                    <p set:html={rich(s.text)} />
                  </article>
                ))}
                <p class="fine"><strong>Stat Changes:</strong> {a.statChanges}</p>
                <p class="fine"><strong>Weaknesses:</strong> <span set:html={rich(a.weaknesses)} /></p>
              </div>
            </section>
          ))}
        </div>
      </div>

      <p class="credit">Last updated {d.updated} &middot; Diamonds are Rank 1.1. Their pages are designed around each Diamond's own submission.</p>
    </div>
  </main>
</Site>

<script>
  // Meteor rocks: float on their own, drift with scroll, and shift with
  // the mouse on devices with hover. Touch screens get the float only.
  // Respects reduced motion: no float, no parallax.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hover = window.matchMedia('(hover: hover)').matches;
  const rocks = Array.from(document.querySelectorAll<HTMLElement>('.meteor, .ring, .orb, .orb-star, .gear'));
  if (!reduce) {
    let mx = 0, my = 0, sy = window.scrollY;
    const apply = () => {
      for (const r of rocks) {
        const depth = parseFloat(r.dataset.depth || '0.5');
        const x = mx * depth * 22;
        const y = my * depth * 16 - sy * depth * 0.12;
        r.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
      }
    };
    if (hover) {
      window.addEventListener('mousemove', (e) => {
        mx = (e.clientX / window.innerWidth - 0.5) * 2;
        my = (e.clientY / window.innerHeight - 0.5) * 2;
        apply();
      }, { passive: true });
    }
    window.addEventListener('scroll', () => { sy = window.scrollY; apply(); }, { passive: true });
    apply();
  }
</script>

<style>
  .diamond { position: relative; background: var(--d-bg); }
  .diamond-content { position: relative; z-index: 2; }
  .crumbs { color: var(--muted); font-size: 0.8rem; letter-spacing: 0.06em; margin: 0 0 0.8rem; }
  .crumbs span { margin: 0 0.3rem; }
  .hero { display: grid; grid-template-columns: minmax(240px, 340px) 1fr; overflow: hidden; }
  .hero-art { background: radial-gradient(circle at 50% 40%, var(--d-glow), transparent 70%), #0a0618; display: grid; place-items: center; }
  .hero-art img { display: block; width: 100%; height: 100%; max-height: 560px; object-fit: cover; object-position: center 20%; }
  .collage { display: grid; grid-template-columns: 1fr 1fr; width: 100%; height: 100%; }
  .collage figure { margin: 0; position: relative; overflow: hidden; min-height: 200px; }
  .collage img { width: 100%; height: 100%; max-height: none; object-fit: cover; object-position: center 30%; }
  .collage figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 0.35rem 0.5rem; font-size: 0.72rem; color: #fff; background: linear-gradient(transparent, rgba(0, 0, 0, 0.75)); }
  .hero-body { padding: 1.2rem 1.4rem; }
  .eyebrow { color: var(--d-accent2); font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; margin: 0 0 0.4rem; }
  .hero h1 { margin: 0 0 0.4rem; font-size: 2.1rem; text-transform: uppercase; letter-spacing: 0.06em; color: #fff; }
  .domains { color: var(--d-accent); font-size: 1.05rem; margin: 0 0 0.8rem; }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 0.3rem 1rem; margin: 0.9rem 0 0; }
  .facts dt { color: var(--muted); font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .facts dd { margin: 0; }
  .subdomains { margin: 0.9rem 0 0; font-size: 0.92rem; color: #ddd5f5; }
  .quote { margin: 1rem 0; padding: 1rem 1.4rem; border-left: 3px solid var(--d-accent2); background: rgba(10, 6, 24, 0.6); font-family: var(--serif); font-size: 1.15rem; color: #f2ecff; }
  .quote p { margin: 0; }
  .cols { display: grid; grid-template-columns: 1fr 1.15fr; gap: 0.9rem; margin-top: 0.9rem; }
  .col { display: flex; flex-direction: column; }
  .col .panel + .panel { margin-top: 0.9rem; }
  .panel .bar { background: linear-gradient(90deg, var(--d-accent), #3d3478 70%); }
  .prose p { margin: 0 0 0.7rem; }
  .prose p:last-child { margin: 0; }
  .power-list { margin: 0; padding-left: 1.1rem; }
  .power-list li + li { margin-top: 0.4rem; }
  .level { color: var(--d-accent2); }
  .ability h3 { font-family: var(--sans); font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--d-accent); margin: 1rem 0 0.5rem; font-weight: 600; }
  .passive { margin: 0 0 0.5rem; font-size: 0.92rem; color: #ddd5f5; }
  .spell { border: 1px solid var(--line); border-left: 3px solid var(--d-accent); background: rgba(5, 3, 16, 0.55); padding: 0.6rem 0.75rem; }
  .spell + .spell { margin-top: 0.5rem; }
  .spell header { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; margin-bottom: 0.3rem; }
  .sname { font-family: var(--serif); font-size: 1rem; color: #fff; }
  .stag { font-size: 0.66rem; letter-spacing: 0.08em; padding: 0.06rem 0.4rem; border: 1px solid var(--line); color: var(--muted); border-radius: 2px; }
  .stag.cost { color: var(--d-accent2); border-color: #e8c46a66; }
  .spell p { margin: 0; color: #ddd5f5; font-size: 0.92rem; }
  .fine { font-size: 0.88rem; color: #cfc6ea; margin: 0.7rem 0 0; }
  :global(.sico) { width: 1.15em; height: 1.15em; vertical-align: -0.22em; margin-right: 0.15em; image-rendering: pixelated; }
  :global(.sico.dark) { background: #c9bfe8; border-radius: 4px; padding: 2px; box-sizing: border-box; }
  .credit { color: var(--muted); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; margin: 1rem 0 0; }
  /* Space background: stars plus meteor rocks, behind the content. */
  .space-bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .stars2 { position: absolute; inset: -40px; background-image:
    radial-gradient(1px 1px at 12% 22%, #fff 50%, transparent 51%),
    radial-gradient(1.5px 1.5px at 72% 12%, #d8ccff 50%, transparent 51%),
    radial-gradient(1px 1px at 42% 68%, #fff 50%, transparent 51%),
    radial-gradient(1px 1px at 88% 52%, #fff 50%, transparent 51%),
    radial-gradient(1.5px 1.5px at 28% 88%, #cbbdff 50%, transparent 51%),
    radial-gradient(1px 1px at 58% 34%, #fff 50%, transparent 51%),
    radial-gradient(1px 1px at 6% 58%, #fff 50%, transparent 51%),
    radial-gradient(1.5px 1.5px at 94% 82%, #e5dcff 50%, transparent 51%);
    background-size: 420px 420px; opacity: 0.85; }
