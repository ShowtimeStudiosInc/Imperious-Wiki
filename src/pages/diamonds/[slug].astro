---
/**
 * Diamond pages. Each Diamond has its own hand-made design in
 * src/diamond-pages/<slug>.html (its styles, markup and script).
 * These pages don't load the site's shared CSS, because the designs use
 * the same class names (panel, chip, stars...). They get their own copy
 * of the top menu instead. {{BASE}} in a design becomes the site's base path.
 */
import { DIAMONDS } from '../../lib/diamonds';
import { url } from '../../lib/gems';

const designs = import.meta.glob('../../diamond-pages/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

export async function getStaticPaths() {
  return DIAMONDS.map((d) => ({ params: { slug: d.slug }, props: { diamond: d } }));
}
const { diamond: d } = Astro.props;
const raw = designs[`../../diamond-pages/${d.slug}.html`];
if (!raw) throw new Error(`No design file for ${d.slug} in src/diamond-pages/`);
const html = raw.replaceAll('{{BASE}}', url('/'));
const fonts = html.match(/<!--fonts-->([\s\S]*?)<!--\/fonts-->/)?.[1] ?? '';
const body = html.replace(/<!--fonts-->[\s\S]*?<!--\/fonts-->/, '');

const title = `${d.name} | Imperious Authorities`;
const desc = `${d.name}${d.pillar ? `, Pillar of ${d.pillar}` : ''}. ${d.purpose}`.slice(0, 200);
const ogImage = new URL(url(d.art || '/images/brand/og-logo.png'), Astro.site).href;
const nav = [
  { href: '/gem-types/', label: 'Gem-Types', key: 'gem-types' },
  { href: '/diamonds/', label: 'Diamonds', key: 'diamonds' },
  { href: '/start-here/welcome/', label: 'Start Here', key: 'start' },
  { href: '/rules/overview/', label: 'Rules', key: 'rules' },
  { href: '/lore/overview/', label: 'Lore', key: 'lore' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#7c4dff" />
    <link rel="icon" href={url('/favicon.png')} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Inter:wght@400;500;600&display=swap" />
    <Fragment set:html={fonts} />
    <style is:inline>
      .ia-top { position: sticky; top: 0; z-index: 1000; display: flex; align-items: center; gap: 1.25rem;
        padding: 0.7rem 1.25rem; background: rgba(7, 5, 13, 0.82); backdrop-filter: blur(8px);
        border-bottom: 1px solid rgba(201, 184, 255, 0.16); font-family: Inter, system-ui, sans-serif; line-height: 1.55; }
      .ia-top a { text-decoration: none; }
      .ia-top .ia-brand { font-family: 'Libre Baskerville', Georgia, serif; font-size: 1.02rem; letter-spacing: 0.04em; color: #ece6ff; display: flex; align-items: center; gap: 0.5rem; }
      .ia-top .ia-brand img { height: 1.6rem; width: auto; display: block; }
      .ia-top nav { display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.86rem; letter-spacing: 0.06em; text-transform: uppercase; }
      .ia-top nav a { color: #a99fc7; }
      .ia-top nav a:hover, .ia-top nav a[aria-current] { color: #ece6ff; }
      @media (max-width: 700px) {
        .ia-top { flex-wrap: wrap; gap: 0.4rem 1rem; padding: 0.6rem 0.9rem; }
        .ia-top nav { gap: 0.8rem; font-size: 0.74rem; }
      }
    </style>
  </head>
  <body>
    <header class="ia-top">
      <a class="ia-brand" href={url('/')}><img src={url('/images/brand/logo-white.png')} alt="" width="22" height="27" /> Imperious Authorities</a>
      <nav aria-label="Main">
        {nav.map((n) => <a href={url(n.href)} aria-current={n.key === 'diamonds' ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </header>
    <Fragment set:html={body} />
  </body>
</html>
