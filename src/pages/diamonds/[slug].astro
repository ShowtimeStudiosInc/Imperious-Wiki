  .r6 svg { animation-duration: 11s; animation-delay: -4s; }
  .orb { position: absolute; border-radius: 50%; background: radial-gradient(circle at 35% 35%, var(--d-accent2), var(--d-accent) 55%, transparent 75%); box-shadow: 0 0 24px 6px var(--d-glow); opacity: 0.8; will-change: transform; animation: drift 10s ease-in-out infinite alternate; }
  .o1 { width: 90px; height: 90px; top: 8%; left: 5%; }
  .o2 { width: 46px; height: 46px; top: 58%; left: 86%; animation-duration: 12s; animation-delay: -3s; }
