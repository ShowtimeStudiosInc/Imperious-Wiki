---
import Site from '../../layouts/Site.astro';
import { DIAMONDS, statusIcon } from '../../lib/diamonds';
import { url } from '../../lib/gems';

export async function getStaticPaths() {
  return DIAMONDS.map((d) => ({ params: { slug: d.slug }, props: { diamond: d } }));
}
const { diamond: d } = Astro.props;
const t = d.theme;

// [[Status]] tokens become the local status icon.
function rich(text: string) {
  return text.replace(/\[\[([\w ]+)\]\]/g, (_, name: string) => {
    const icon = statusIcon(name);
    if (!icon) return name;
    return `<img class="sico${icon.dark ? ' dark' : ''}" src="${url(`/images/statuses/${icon.file}`)}" alt="${name}" title="${name}" /> ${name}`;
  });
}
const desc = `${d.name}${d.pillar ? `, Pillar of ${d.pillar}` : ''}. ${d.purpose}`.slice(0, 200);
---

<Site title={d.name} description={desc} current="diamonds">
  <main
    class="wrap diamond"
    style={`--d-bg: ${t.bg}; --d-glow: ${t.glow}; --d-accent: ${t.accent}; --d-accent2: ${t.accent2};`}
  >
    {t.rings && (
      <div class="space-bg" aria-hidden="true">
        <div class="stars2" />
        <div class="ring r1" data-depth="0.3"><svg viewBox="0 0 200 80"><ellipse cx="100" cy="40" rx="92" ry="26" /><ellipse cx="100" cy="40" rx="62" ry="16" /><circle cx="100" cy="40" r="10" /></svg></div>
        <div class="ring r2" data-depth="0.7"><svg viewBox="0 0 200 80"><ellipse cx="100" cy="40" rx="92" ry="26" /><ellipse cx="100" cy="40" rx="62" ry="16" /><circle cx="100" cy="40" r="10" /></svg></div>
        <div class="ring r3" data-depth="1.1"><svg viewBox="0 0 200 80"><ellipse cx="100" cy="40" rx="92" ry="26" /><ellipse cx="100" cy="40" rx="62" ry="16" /><circle cx="100" cy="40" r="10" /></svg></div>
        <div class="ring r4" data-depth="0.5"><svg viewBox="0 0 200 80"><ellipse cx="100" cy="40" rx="92" ry="26" /><ellipse cx="100" cy="40" rx="62" ry="16" /><circle cx="100" cy="40" r="10" /></svg></div>
        <div class="ring r5" data-depth="1.4"><svg viewBox="0 0 200 80"><ellipse cx="100" cy="40" rx="92" ry="26" /><ellipse cx="100" cy="40" rx="62" ry="16" /><circle cx="100" cy="40" r="10" /></svg></div>
        <div class="ring r6" data-depth="0.9"><svg viewBox="0 0 200 80"><ellipse cx="100" cy="40" rx="92" ry="26" /><ellipse cx="100" cy="40" rx="62" ry="16" /><circle cx="100" cy="40" r="10" /></svg></div>
      </div>
    )}
    {t.orbs && (
      <div class="space-bg" aria-hidden="true">
        <div class="stars2" />
        <div class="orb o1" data-depth="0.3" />
        <div class="orb o2" data-depth="0.7" />
        <div class="orb o3" data-depth="1.1" />
        <div class="orb o4" data-depth="0.5" />
        <div class="orb o5" data-depth="1.4" />
        <div class="orb o6" data-depth="0.9" />
        <div class="orb-star s1" data-depth="0.6"><svg viewBox="0 0 40 40"><polygon points="20,2 24,16 38,20 24,24 20,38 16,24 2,20 16,16" /></svg></div>
        <div class="orb-star s2" data-depth="1.2"><svg viewBox="0 0 40 40"><polygon points="20,2 24,16 38,20 24,24 20,38 16,24 2,20 16,16" /></svg></div>
        <div class="orb-star s3" data-depth="0.4"><svg viewBox="0 0 40 40"><polygon points="20,2 24,16 38,20 24,24 20,38 16,24 2,20 16,16" /></svg></div>
        <div class="orb-star s4" data-depth="0.8"><svg viewBox="0 0 40 40"><polygon points="20,2 24,16 38,20 24,24 20,38 16,24 2,20 16,16" /></svg></div>
      </div>
    )}
    {t.gears && (
