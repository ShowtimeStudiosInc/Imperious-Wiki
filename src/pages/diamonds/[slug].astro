  .r5 { width: 160px; top: 90%; left: 60%; transform: rotate(14deg); }
  .r6 { width: 110px; top: 6%; left: 55%; transform: rotate(-8deg); }
  .r2 svg { animation-duration: 12s; animation-delay: -3s; }
  .r3 svg { animation-duration: 14s; animation-delay: -5s; }
