---
import Site from '../../layouts/Site.astro';
import { url } from '../../lib/gems';
import { storylines } from '../../lib/storylines';
---
<Site title="Events" description="Storylines and events running on the server right now." current="events">
  <main class="evx" data-pagefind-body>
    <p class="kicker">Events</p>
    <h1>What's happening now</h1>
    <p class="sub">Storylines running on the server, with everything you need to take part. Finished events live on the <a href={url('/timeline/')}>Timeline</a>.</p>
    <div class="grid">
      {storylines.map((s) => (
        <a class="ev-card" href={url(`/events/${s.slug}/`)}>
          <span class="k">{s.kind} · {s.era}</span>
          <h2>{s.title}</h2>
          <p>{s.tagline}</p>
          <span class="st">{s.status}</span>
        </a>
      ))}
    </div>
  </main>
</Site>
<style>
  .evx { max-width: 1000px; margin: 0 auto; padding: 40px 22px 90px; }
  .kicker { font: 600 11px/1 var(--sans); letter-spacing: 0.24em; text-transform: uppercase; color: #8fe3ff; margin: 0 0 10px; }
  h1 { font: 400 38px/1.1 var(--serif); margin: 0 0 10px; }
  .sub { color: var(--muted); max-width: 62ch; }
  .sub a { color: #8fe3ff; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; margin-top: 28px; }
  .ev-card { display: block; padding: 24px; border: 1px solid rgba(143, 227, 255, 0.25); border-radius: 6px; text-decoration: none; color: inherit;
    background: radial-gradient(120% 140% at 100% 0%, rgba(143, 227, 255, 0.14), transparent 55%), var(--panel); }
  .ev-card:hover { border-color: #8fe3ff; }
  .k { font: 600 11px/1 var(--sans); letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
  .ev-card h2 { font: 400 24px/1.2 var(--serif); margin: 10px 0 6px; color: var(--text); }
  .ev-card p { color: var(--muted); margin: 0 0 14px; }
  .st { font: 600 11px/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: #b9f6c7; }
</style>
