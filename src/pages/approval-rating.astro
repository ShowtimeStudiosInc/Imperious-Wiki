---
import Site from '../layouts/Site.astro';
import { url } from '../lib/gems';
import { groups, updated, logByDate, changeLabel, changeClass, votesLabel, unrest, unrestLevel, kindLabel, earlierNews } from '../lib/popularity';
const boards = groups;
---
<Site title="Diamond Approval Rating" description="How the Gempire feels about its Diamonds and Grand Regents, and what changed it.">
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;600;700&display=swap" />
  <main class="wrap pop-page" data-pagefind-body>
    <header class="top">
      <svg class="mark" width="60" height="48" viewBox="0 0 20 16" shape-rendering="crispEdges" aria-hidden="true"><path fill="#ff4fa3" d="M2 2h16v1h1v10h-1v1H2v-1H1V3h1zM6 0h1v1h1v1H6zM13 0h1v2h-2V1h1zM6 15h2v1H6zM12 15h2v1h-2z"/><path fill="#1d0d2e" d="M3 4h14v8H3z"/><path fill="#7fe0a8" d="M5 9h2v2H5zM8 7h2v4H8zM11 5h2v6h-2zM14 8h1v3h-1z"/></svg>
      <h1>Diamond Approval Rating</h1>
      <p>How the empire feels about its Diamonds and Grand Regents, out of 100, from the Hematite polls. Arrows show the change over the last 7 days. Updated {updated}.</p>
    </header>
    {unrest != null && (
      <section class="unrest" data-level={unrestLevel(unrest).toLowerCase()}>
        <div class="ur-top"><h2>Unrest</h2><span class="ur-val">{unrest}<small>/100</small> · {unrestLevel(unrest)}</span></div>
        <span class="ur-bar" role="img" aria-label={`Unrest ${unrest} out of 100, ${unrestLevel(unrest)}`}><span style={`width:${unrest}%`} /><i style="left:25%" /><i style="left:50%" /><i style="left:75%" /></span>
        <div class="ur-scale"><span>Calm</span><span>Uneasy</span><span>Restless</span><span>Boiling</span></div>
        <p>How restless the Gempire is as a whole. It climbs when the Diamonds are unpopular and when bad news piles up. The higher it gets, the worse the events that can happen.</p>
      </section>
    )}

    <div class="boards">
      {boards.map((b) => (
        <section class="tv">
          <h2>{b.title}</h2>
          <ol>
            {b.rows.map((r, i) => (
              <li>
                <span class="n">{i + 1}</span>
                <span class="who">
                  {r.href ? <a href={r.href}>{r.name}</a> : <span class="nolink">{r.name}</span>}
                  {r.votes != null && <small>{votesLabel(r.votes)}</small>}
                </span>
                <span class="tr" role="img" aria-label={`${r.score} out of 100`}><span style={`width:${r.score}%`} /></span>
                <span class="sc">{r.score}</span>
                <span class={`ch ${changeClass(r.change)}`}>{changeLabel(r.change)}<span class="sr"> since the last update</span></span>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    <section class="log">
      <h2>What moved the numbers</h2>
      {logByDate.map((g) => (
        <div class="day">
          <h3>{g.date}</h3>
          <ul>
            {g.items.map((l) => (
              <li>
                <span class={`ch badge ${changeClass(l.change)}`}>{changeLabel(l.change)}</span>
                <div>
                  {l.person.href ? <a href={l.person.href}>{l.person.name}</a> : <span class="nolink">{l.person.name}</span>}
                  <span class="kind">{kindLabel(l.kind)}</span>
                  <p>{l.text}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    {earlierNews.length > 0 && (
      <section class="log earlier">
        <h2>Timeline</h2>
        <p class="sub">Homeworld Times broadcasts and weekly headlines that moved the numbers, kept for good. <a href={url('/news/')}>Read the broadcasts in full</a>.</p>
        {earlierNews.map((n) => (
          <div class="day">
            <h3>{n.news ? <a href={url(`/news/${n.news}/`)}>{n.title}</a> : n.title}</h3>
            {n.source && <p class="src">{n.source}</p>}
            {n.weekly && <p class="src">Weekly headline</p>}
            {n.headline && <p class="headline">{n.headline}</p>}
            <ul>
              {n.changes.map((l) => (
                <li>
                  <span class={`ch badge ${changeClass(l.change)}`}>{changeLabel(l.change)}</span>
                  <div>
                    {l.person.href ? <a href={l.person.href}>{l.person.name}</a> : <span class="nolink">{l.person.name}</span>}
                    <span class="kind">{n.weekly ? 'Weekly headline' : 'News report'}</span>
                    {l.text && <p>{l.text}</p>}
                  </div>
                </li>
              ))}
              {n.unrest ? (
                <li>
                  <span class={`ch badge ${n.unrest > 0 ? 'down' : 'up'}`}>{n.unrest > 0 ? `+${n.unrest}` : n.unrest}</span>
                  <div>
                    <span class="nolink">Unrest</span>
                    <span class="kind">{n.weekly ? 'Weekly headline' : 'News report'}</span>
                    {n.unrest_text && <p>{n.unrest_text}</p>}
                  </div>
                </li>
              ) : null}
            </ul>
          </div>
        ))}
      </section>
    )}
    <aside class="ooc">
      <strong>Out of character:</strong> these numbers are the Gempire's opinion, not a member vote. They update on their own: a small event every 3 hours, a medium one every few days, and a weekly report with an update roll for everyone. Staff can still adjust them by hand after story events. Random events are background news. If one doesn't fit the story, staff can remove it.
    </aside>
  </main>
</Site>
<style>
  .pop-page { --pink: #ff4fa3; --mint: #7fe0a8; --dim: #b49bd0; padding-bottom: 3rem; }
  .pixel, .top h1, .tv h2, .log h2, .log h3 { font-family: 'Pixelify Sans', var(--serif), monospace; }
  .top { text-align: center; padding: 2.4rem 0 1.4rem; }
  .mark { filter: drop-shadow(0 0 10px rgba(255, 79, 163, 0.5)); }
  .top h1 { color: var(--pink); font-size: clamp(1.8rem, 5vw, 2.8rem); letter-spacing: 0.06em; text-transform: uppercase; margin: 0.4rem 0; text-shadow: 0 0 14px rgba(255, 79, 163, 0.5); }
  .top p { color: var(--muted); max-width: 40rem; margin: 0 auto; }
  .boards { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .boards > .tv:first-child { grid-column: 1 / -1; }
  .who small { display: block; color: var(--dim); font-size: 0.74rem; margin-top: 0.1rem; }
  .nolink { color: #f3e8ff; }
  .tv { position: relative; overflow: hidden; padding: 1rem 1.2rem; border-radius: 12px; border: 2px solid var(--pink);
    background: radial-gradient(ellipse at 50% 20%, #2b1745, #120a1e 80%); box-shadow: 0 0 22px rgba(255, 79, 163, 0.25); }
  .tv::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.04) 0 1px, transparent 1px 3px); }
  .tv h2 { color: var(--mint); font-size: 1.1rem; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 0.5rem; }
  .tv ol { list-style: none; margin: 0; padding: 0; }
  .tv li { display: grid; grid-template-columns: 1rem minmax(0, 1.4fr) minmax(70px, 1fr) 2rem 2.6rem; gap: 0.6rem; align-items: center; padding: 0.5rem 0; border-bottom: 1px solid rgba(255, 255, 255, 0.07); }
  .tv li:last-child { border-bottom: 0; }
  .n { color: var(--dim); font-size: 0.8rem; text-align: right; }
  .tv a, .log a { color: #f3e8ff; }
  .tv a:hover, .log a:hover { color: var(--pink); }
  .tr { height: 8px; border-radius: 4px; background: rgba(255, 255, 255, 0.1); overflow: hidden; }
  .tr span { display: block; height: 100%; border-radius: 4px; background: var(--pink); }
  .sc { text-align: right; font-variant-numeric: tabular-nums; color: #f3e8ff; }
  .ch { font-size: 0.8rem; color: var(--dim); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .ch.up { color: var(--mint); } .ch.down { color: #ff8a8a; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .log { margin-top: 2rem; }
  .unrest { margin: 0 auto 1.4rem; max-width: 46rem; padding: 0.9rem 1.2rem 1rem; border-radius: 12px; border: 2px solid var(--ur, #e8c46a);
    background: radial-gradient(ellipse at 50% 0%, #2b1745, #120a1e 85%); --ur: #e8c46a; }
  .unrest[data-level='calm'] { --ur: #7fe0a8; } .unrest[data-level='restless'] { --ur: #ff9b5c; } .unrest[data-level='boiling'] { --ur: #ff4f6a; }
  .ur-top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .unrest h2 { font-family: 'Pixelify Sans', var(--serif), monospace; color: var(--ur); text-transform: uppercase; letter-spacing: 0.1em; font-size: 1.1rem; margin: 0; }
  .ur-val { font-family: 'Pixelify Sans', monospace; color: #f3e8ff; font-size: 1.1rem; } .ur-val small { color: var(--dim); font-size: 0.75rem; }
  .ur-bar { position: relative; display: block; height: 12px; margin: 0.6rem 0 0.25rem; border-radius: 6px; background: linear-gradient(90deg, rgba(127,224,168,.18), rgba(232,196,106,.18), rgba(255,155,92,.18), rgba(255,79,106,.22)); overflow: hidden; }
  .ur-bar > span { display: block; height: 100%; background: var(--ur); border-radius: 6px; box-shadow: 0 0 10px var(--ur); }
  .ur-bar i { position: absolute; top: 0; bottom: 0; width: 2px; background: #120a1e; }
  .ur-scale { display: grid; grid-template-columns: repeat(4, 1fr); font-size: 0.7rem; color: var(--dim); text-transform: uppercase; letter-spacing: 0.06em; }
  .ur-scale span:nth-child(2) { text-align: left; } .ur-scale span:last-child { text-align: right; }
  .unrest p { margin: 0.5rem 0 0; color: var(--muted); font-size: 0.88rem; }
  .log h2 { color: var(--pink); font-size: 1.4rem; letter-spacing: 0.05em; margin: 0 0 0.6rem; }
  .log h3 { color: var(--mint); font-size: 0.95rem; letter-spacing: 0.08em; text-transform: uppercase; margin: 1rem 0 0.4rem; }
  .log ul { list-style: none; margin: 0; padding: 0; }
  .log li { display: grid; grid-template-columns: 3.2rem 1fr; gap: 0.8rem; padding: 0.75rem 0; border-bottom: 1px solid rgba(201, 184, 255, 0.1); }
  .badge { align-self: start; text-align: center; padding: 0.2rem 0; border-radius: 6px; background: rgba(255, 255, 255, 0.06); border: 1px solid currentColor; }
  .kind { margin-left: 0.5rem; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--dim); }
  .log p { margin: 0.2rem 0 0; color: var(--text); }
  .earlier .sub, .earlier .src { color: var(--dim); font-size: 0.85rem; margin: 0 0 0.4rem; }
  .earlier .src { margin: -0.2rem 0 0.2rem; font-style: italic; }
  .earlier .headline { margin: 0.2rem 0 0.4rem; color: var(--text); }
  .ooc { margin-top: 2rem; padding: 0.9rem 1rem; border-radius: 10px; border: 1px dashed rgba(201, 184, 255, 0.35); color: var(--muted); font-size: 0.9rem; }
  .ooc strong { color: var(--text); }
  @media (max-width: 820px) { .boards { grid-template-columns: 1fr; } .tv li { grid-template-columns: 1rem minmax(0, 1.4fr) 60px 2rem 2.4rem; gap: 0.45rem; } }
</style>
