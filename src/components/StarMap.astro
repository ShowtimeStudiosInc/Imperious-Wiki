---
/**
 * Home page star map. Each section of the wiki is a planet you can travel to.
 * Planets are placed in % of the map box; on narrow screens the map becomes a list.
 */
import { url } from '../lib/gems';
interface Props { gemCount: number }
const { gemCount } = Astro.props;

const dests = [
  { id: 'start', href: '/start-here/welcome/', name: 'Start Here', kicker: 'New arrivals', text: 'What the setting is, and how to build your first Gem.', x: 37, y: 36, size: 64 },
  { id: 'gems', href: '/gem-types/', name: 'Gem-Types', kicker: `${gemCount} catalogued`, text: 'Every type in the empire, from Servants to Transcendents.', x: 71, y: 30, size: 118 },
  { id: 'diamonds', href: '/diamonds/', name: 'Know Your Diamond', kicker: 'Rank 1.1', text: 'The Deity and Ruling Diamonds, and their Grand Regents.', x: 23, y: 66, size: 104 },
  { id: 'rules', href: '/rules/overview/', name: 'Rules', kicker: 'How play works', text: 'Battles, stats, abilities, items, SKILLs and statuses.', x: 61, y: 74, size: 92 },
  { id: 'lore', href: '/lore/overview/', name: 'Lore', kicker: 'The setting', text: 'Factions, Gempire life, how Gems work, wildlife and ships.', x: 87, y: 62, size: 128 },
  { id: 'approval', href: '/approval-rating/', name: 'Approval Rating', kicker: 'Holovision', text: 'How the empire feels about its Diamonds right now.', x: 13, y: 27, size: 58 },
];

// Stars are placed once at build time so the map looks the same on every visit.
let seed = 7;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const stars = Array.from({ length: 170 }, () => ({ x: rnd() * 100, y: rnd() * 100, r: rnd() < 0.85 ? 0.6 + rnd() * 0.6 : 1.3 + rnd() * 0.8, o: 0.25 + rnd() * 0.6 }));
---
<section class="map" aria-label="Wiki map: pick a destination">
  <svg class="sky" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r * 0.12} opacity={s.o} />)}
  </svg>
  <div class="nebula" aria-hidden="true"></div>

  <svg class="orbits" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <ellipse cx="50" cy="51" rx="15" ry="13" />
    <ellipse cx="50" cy="51" rx="29" ry="25" />
    <ellipse cx="50" cy="51" rx="40" ry="34" />
  </svg>

  <div class="core" aria-hidden="true">
    <img src={url('/images/brand/logo-white.png')} alt="" width="134" height="162" />
  </div>
  <h1 class="map-title">Imperious Authorities</h1>
  <p class="map-hint">Pick a destination</p>

  {dests.map((d) => (
    <a class={`dest dest-${d.id}`} href={url(d.href)} style={`--x:${d.x}%;--y:${d.y}%;--size:${d.size}px`}>
      <span class="planet" aria-hidden="true">
        {d.id === 'gems' && (
          <svg viewBox="0 0 100 100">
            <defs><radialGradient id="pg-gems" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="#f3e8ff" /><stop offset=".5" stop-color="#b69cff" /><stop offset="1" stop-color="#4b2a8f" /></radialGradient></defs>
            <circle cx="50" cy="50" r="46" fill="url(#pg-gems)" />
            <g fill="#ffffff" opacity=".22"><polygon points="50,6 70,30 50,44 30,30" /><polygon points="70,30 94,50 72,62 50,44" /><polygon points="30,30 50,44 28,62 6,50" /><polygon points="50,44 72,62 50,94 28,62" opacity=".5" /></g>
            <g fill="none" stroke="#ffffff" stroke-width="1.2" opacity=".55"><polyline points="50,6 70,30 94,50" /><polyline points="50,6 30,30 6,50" /><polyline points="30,30 50,44 70,30" /><polyline points="50,44 50,94" /><polyline points="28,62 50,44 72,62" /></g>
          </svg>
        )}
        {d.id === 'diamonds' && (
          <svg viewBox="0 0 100 100">
            <defs><radialGradient id="pg-dia" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="#ffffff" /><stop offset=".55" stop-color="#d9d4ee" /><stop offset="1" stop-color="#6e6690" /></radialGradient></defs>
            <ellipse cx="50" cy="52" rx="49" ry="12" fill="none" stroke="#e9e2ff" stroke-width="3" opacity=".35" transform="rotate(-14 50 52)" />
            <circle cx="50" cy="50" r="34" fill="url(#pg-dia)" />
            <path d="M3 61 A49 12 0 0 0 97 43" fill="none" stroke="#f5f0ff" stroke-width="3" opacity=".9" transform="rotate(-14 50 52)" />
            <g fill="#ffffff"><polygon points="50,30 56,40 50,50 44,40" opacity=".8" /></g>
          </svg>
        )}
        {d.id === 'rules' && (
          <svg viewBox="0 0 100 100">
            <defs><radialGradient id="pg-rules" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="#d7ecff" /><stop offset=".55" stop-color="#6aa0d8" /><stop offset="1" stop-color="#1f3a6a" /></radialGradient><clipPath id="pc-rules"><circle cx="50" cy="50" r="44" /></clipPath></defs>
            <circle cx="50" cy="50" r="44" fill="url(#pg-rules)" />
            <g clip-path="url(#pc-rules)" fill="none" stroke="#e8f3ff" stroke-width="1" opacity=".45">
              <ellipse cx="50" cy="50" rx="44" ry="14" /><ellipse cx="50" cy="50" rx="44" ry="30" /><line x1="6" y1="50" x2="94" y2="50" />
              <ellipse cx="50" cy="50" rx="14" ry="44" /><ellipse cx="50" cy="50" rx="30" ry="44" /><line x1="50" y1="6" x2="50" y2="94" />
            </g>
          </svg>
        )}
        {d.id === 'lore' && (
          <svg viewBox="0 0 100 100">
            <defs><radialGradient id="pg-lore" cx=".35" cy=".3" r=".85"><stop offset="0" stop-color="#ffe2b8" /><stop offset=".5" stop-color="#d98a5a" /><stop offset="1" stop-color="#5a2a4a" /></radialGradient><clipPath id="pc-lore"><circle cx="46" cy="52" r="40" /></clipPath></defs>
            <circle cx="46" cy="52" r="40" fill="url(#pg-lore)" />
            <g clip-path="url(#pc-lore)" fill="none" stroke-linecap="round">
              <path d="M2 38 Q30 32 50 38 T92 36" stroke="#fff1dc" stroke-width="4" opacity=".35" />
              <path d="M2 52 Q26 58 48 52 T92 54" stroke="#7a2e4a" stroke-width="6" opacity=".35" />
              <path d="M2 66 Q34 60 56 66 T92 64" stroke="#fff1dc" stroke-width="3" opacity=".3" />
              <ellipse cx="60" cy="58" rx="7" ry="4" fill="#7a2e4a" opacity=".45" stroke="none" />
            </g>
            <circle cx="88" cy="18" r="7" fill="#e9dcff" />
          </svg>
        )}
        {d.id === 'start' && (
          <svg viewBox="0 0 100 100">
            <defs><radialGradient id="pg-start" cx=".4" cy=".35" r=".75"><stop offset="0" stop-color="#ffffff" /><stop offset=".5" stop-color="#a8f0e0" /><stop offset="1" stop-color="#2a7a7a" /></radialGradient></defs>
            <circle class="beacon" cx="50" cy="50" r="40" fill="none" stroke="#a8f0e0" stroke-width="3" />
            <circle cx="50" cy="50" r="40" fill="url(#pg-start)" />
          </svg>
        )}
        {d.id === 'approval' && (
          <svg viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="40" fill="none" stroke="#ff4fa3" stroke-width="6" />
            <circle cx="50" cy="50" r="40" fill="none" stroke="#7fe0a8" stroke-width="2" stroke-dasharray="6 9" />
            <rect x="34" y="38" width="32" height="24" rx="4" fill="#2b1745" stroke="#ff4fa3" stroke-width="3" />
            <rect x="40" y="50" width="4" height="8" fill="#7fe0a8" /><rect x="47" y="45" width="4" height="13" fill="#7fe0a8" /><rect x="54" y="48" width="4" height="10" fill="#ff4fa3" />
            <line x1="50" y1="10" x2="50" y2="38" stroke="#ff4fa3" stroke-width="3" /><line x1="50" y1="62" x2="50" y2="90" stroke="#ff4fa3" stroke-width="3" />
          </svg>
        )}
      </span>
      <span class="label"><strong>{d.name}</strong><small>{d.kicker}</small></span>
      <span class="card" role="presentation"><span>{d.text}</span><em>Travel ›</em></span>
    </a>
  ))}
</section>

<script>
  // Gentle parallax on devices with a mouse; touch screens and reduced motion get a still map.
  const map = document.querySelector<HTMLElement>('.map');
  if (map && matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    map.addEventListener('pointermove', (e) => {
      const r = map.getBoundingClientRect();
      map.style.setProperty('--px', ((e.clientX - r.left) / r.width - 0.5).toFixed(3));
      map.style.setProperty('--py', ((e.clientY - r.top) / r.height - 0.5).toFixed(3));
    });
    map.addEventListener('pointerleave', () => { map.style.setProperty('--px', '0'); map.style.setProperty('--py', '0'); });
  }
</script>

<style>
  .map { --px: 0; --py: 0; position: relative; height: clamp(560px, 74vh, 760px); margin: 0 0 1.2rem; border: 1px solid var(--line); border-radius: 18px; overflow: hidden;
    background: radial-gradient(60% 55% at 50% 51%, rgba(124, 77, 255, 0.18), transparent 70%), radial-gradient(120% 90% at 50% 40%, #150c2a, #07040f 75%); }
  .sky { position: absolute; inset: -2%; width: 104%; height: 104%; fill: #efe6ff; transform: translate(calc(var(--px) * -10px), calc(var(--py) * -10px)); transition: transform 0.3s ease-out; }
  .nebula { position: absolute; inset: 0; pointer-events: none; opacity: 0.6;
    background: radial-gradient(35% 30% at 18% 78%, rgba(255, 79, 163, 0.12), transparent 70%), radial-gradient(30% 28% at 82% 20%, rgba(95, 180, 255, 0.12), transparent 70%); }
  .orbits { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: var(--lav, #c9b8ff); stroke-width: 0.12; opacity: 0.28; stroke-dasharray: 0.6 0.8; transform: translate(calc(var(--px) * -4px), calc(var(--py) * -4px)); }
  .core { position: absolute; left: 50%; top: 51%; width: 132px; height: 132px; transform: translate(-50%, -50%); display: grid; place-items: center; border-radius: 50%;
    background: radial-gradient(circle, var(--glow, rgba(124, 77, 255, 0.45)) 0%, transparent 68%); }
  .core img { height: 84px; width: auto; filter: drop-shadow(0 0 14px var(--glow, rgba(124, 77, 255, 0.6))); }
  .map-title { position: absolute; left: 1.4rem; top: 1rem; margin: 0; font-size: clamp(1.1rem, 2.4vw, 1.6rem); letter-spacing: 0.14em; text-transform: uppercase; }
  .map-hint { position: absolute; left: 1.45rem; top: 3.1rem; margin: 0; color: var(--muted); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; }

  .dest { position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%) translate(calc(var(--px) * 12px), calc(var(--py) * 12px)); transition: transform 0.3s ease-out; color: var(--text); text-decoration: none; display: grid; justify-items: center; gap: 0.35rem; z-index: 1; }
  .planet { display: block; width: var(--size); height: var(--size); border-radius: 50%; transition: transform 0.25s ease, filter 0.25s ease; filter: drop-shadow(0 0 0 transparent); animation: bob 7s ease-in-out infinite; }
  .dest-gems .planet { animation-delay: -2s; } .dest-lore .planet { animation-delay: -4s; } .dest-rules .planet { animation-delay: -1s; } .dest-diamonds .planet { animation-delay: -5s; }
  .planet svg { width: 100%; height: 100%; overflow: visible; }
  @keyframes bob { 0%, 100% { translate: 0 0; } 50% { translate: 0 -5px; } }
  .beacon { transform-origin: 50px 50px; animation: beacon 2.8s ease-out infinite; }
  @keyframes beacon { 0% { transform: scale(1); opacity: 0.7; } 100% { transform: scale(1.6); opacity: 0; } }

  .label { display: grid; justify-items: center; text-align: center; line-height: 1.15; pointer-events: none; }
  .label strong { font-family: var(--serif); font-weight: 400; font-size: 1.02rem; letter-spacing: 0.06em; text-shadow: 0 1px 8px #07040f; }
  .label small { color: var(--muted); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; }

  .card { position: absolute; top: calc(100% + 0.4rem); left: 50%; width: 15rem; transform: translate(-50%, 4px); opacity: 0; pointer-events: none; transition: opacity 0.18s, transform 0.18s;
    padding: 0.65rem 0.8rem; border-radius: 10px; background: rgba(14, 9, 28, 0.94); border: 1px solid var(--line-strong); font-size: 0.84rem; color: var(--text); text-align: left; display: grid; gap: 0.3rem; box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45); }
  .card em { font-style: normal; color: var(--lav); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .dest-rules .card, .dest-diamonds .card { top: auto; bottom: calc(100% + 0.4rem); }
  .dest-lore .card { left: auto; right: 0; transform: translate(0, 4px); }
  .dest-approval .card { left: 0; transform: translate(0, 4px); }

  .dest:hover, .dest:focus-visible { z-index: 3; }
  .dest:hover .planet, .dest:focus-visible .planet { transform: scale(1.08); filter: drop-shadow(0 0 16px var(--glow, rgba(124, 77, 255, 0.6))); }
  .dest:hover .card, .dest:focus-visible .card { opacity: 1; transform: translate(-50%, 0); }
  .dest-lore:hover .card, .dest-lore:focus-visible .card, .dest-approval:hover .card, .dest-approval:focus-visible .card { transform: translate(0, 0); }
  .dest:focus-visible { outline: none; }
  .dest:focus-visible .label strong { text-decoration: underline; text-underline-offset: 4px; }

  @media (prefers-reduced-motion: reduce) { .planet, .beacon { animation: none !important; } .beacon { display: none; } .sky, .orbits, .dest { transition: none; } }

  /* Phones: the map becomes a list of planets */
  @media (max-width: 760px) {
    .map { height: auto; padding: 5.2rem 1rem 1rem; display: grid; gap: 0.6rem; }
    .orbits, .core { display: none; }
    .dest { position: static; transform: none; display: grid; grid-template-columns: 64px 1fr; grid-template-areas: 'p l' 'p c'; justify-items: start; align-items: center; gap: 0 0.9rem; padding: 0.6rem 0.7rem; border: 1px solid var(--line); border-radius: 12px; background: rgba(14, 9, 28, 0.6); }
    .planet { grid-area: p; width: 60px; height: 60px; animation: none; }
    .label { grid-area: l; justify-items: start; text-align: left; }
    .card { grid-area: c; position: static; opacity: 1; transform: none !important; width: auto; padding: 0; background: none; border: 0; box-shadow: none; font-size: 0.8rem; color: var(--muted); }
    .card em { display: none; }
  }
</style>
