---
// Optional read-aloud player for TV episodes. Uses the browser's own text to speech,
// so nothing is recorded or stored on the server. Hidden on browsers that can't speak.
const { host = '', episode = '' } = Astro.props;
const TTS = import.meta.env.PUBLIC_TTS_URL || 'https://ia-wiki-presence.dilanrodriguez091.workers.dev/tts';
---
<div class="lp" data-lp data-host={host} data-ep={episode} data-tts-url={TTS} hidden>
  <button type="button" class="lp-open" data-lp-open aria-expanded="false">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    Listen
  </button>
  <div class="lp-bar" data-lp-bar hidden>
    <div class="lp-controls">
      <button type="button" data-lp-prev aria-label="Previous line">⏮</button>
      <button type="button" class="lp-play" data-lp-play aria-label="Play">▶</button>
      <button type="button" data-lp-next aria-label="Next line">⏭</button>
      <button type="button" data-lp-stop aria-label="Stop">■</button>
    </div>
    <div class="lp-now" data-lp-now aria-live="polite">Press play to start.</div>
    <div class="lp-opts">
      <label>Speed
        <select data-lp-rate>
          <option value="0.85">0.85×</option>
          <option value="1" selected>1×</option>
          <option value="1.15">1.15×</option>
          <option value="1.3">1.3×</option>
          <option value="1.5">1.5×</option>
        </select>
      </label>
      <label class="lp-check"><input type="checkbox" data-lp-notes /> Read camera notes</label>
    </div>
    <p class="lp-tip" data-lp-tip>Voices come from your device. Click any line to start there.</p>
  </div>
</div>

<style>
  .lp { margin: 1.1rem 0 0; }
  :global(.lp-float) { margin: 0; }
  .lp-open { display: inline-flex; align-items: center; gap: .45rem; padding: .4rem .85rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--c, #c46bff) 60%, transparent);
    background: transparent; color: #e9dcf5; font: 600 .85rem/1 inherit; cursor: pointer; }
  .lp-open svg { width: 16px; height: 16px; fill: currentColor; }
  .lp-open:hover, .lp-open[aria-expanded="true"] { background: color-mix(in srgb, var(--c, #c46bff) 25%, transparent); color: #fff; }

  /* The player sits in the empty left margin on wide screens, and drops to a slim bottom bar on small ones. */
  .lp-bar { position: fixed; z-index: 50; left: max(.75rem, calc(50vw - 615px)); top: 50%; transform: translateY(-50%);
    width: 190px; padding: .75rem; border-radius: 14px; background: rgba(18, 10, 30, .82); backdrop-filter: blur(6px);
    border: 1px solid color-mix(in srgb, var(--c, #c46bff) 35%, transparent); display: grid; gap: .6rem; }
  .lp-controls { display: flex; gap: .3rem; justify-content: space-between; }
  .lp-controls button { width: 2rem; height: 2rem; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .16); background: rgba(255, 255, 255, .05);
    color: #fff; font-size: .8rem; cursor: pointer; }
  .lp-controls .lp-play { background: var(--c, #c46bff); border-color: transparent; }
  .lp-now { font-size: .8rem; line-height: 1.35; color: #d9cbe8; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .lp-now b { color: var(--a, #ffd27a); display: block; }
  .lp-opts { display: grid; gap: .4rem; font-size: .78rem; color: #b9abcb; }
  .lp-opts select { margin-left: .3rem; background: #1d1330; color: #fff; border: 1px solid rgba(255, 255, 255, .18); border-radius: 6px; padding: .1rem .25rem; font-size: .78rem; }
  .lp-check { display: flex; gap: .35rem; align-items: center; cursor: pointer; }
  .lp-tip { margin: 0; font-size: .7rem; line-height: 1.35; color: #8a7d9c; }
  @media (max-width: 1260px) {
    .lp-bar { left: 50%; top: auto; bottom: .75rem; transform: translateX(-50%); width: min(560px, calc(100vw - 1.5rem));
      grid-template-columns: auto 1fr; align-items: center; padding: .55rem .75rem; }
    .lp-now { -webkit-line-clamp: 2; } .lp-now b { display: inline; margin-right: .3rem; }
    .lp-opts { display: none; }
    .lp-tip { display: none; }
    :global(body.lp-on) { padding-bottom: 7rem; }
  }
  :global(.lp-on .ht-script [data-tts]) { cursor: pointer; border-radius: 6px; }
  :global(.lp-on .ht-script [data-tts]:hover) { background: rgba(255, 255, 255, .04); }
  :global(.ht-script .lp-current) { background: color-mix(in srgb, var(--c, #c46bff) 18%, transparent) !important; box-shadow: -6px 0 0 color-mix(in srgb, var(--c, #c46bff) 70%, transparent); }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-lp]');
  const synth = window.speechSynthesis;
  if (root && synth && 'SpeechSynthesisUtterance' in window) {
    root.hidden = false;
    const $ = <T extends Element>(s: string) => (root.querySelector<T>(s) || document.querySelector<T>(s))!;
    const openBtn = $<HTMLButtonElement>('[data-lp-open]');
    const bar = $<HTMLElement>('[data-lp-bar]');
    const playBtn = $<HTMLButtonElement>('[data-lp-play]');
    const now = $<HTMLElement>('[data-lp-now]');
    const rateSel = $<HTMLSelectElement>('[data-lp-rate]');
    const notesBox = $<HTMLInputElement>('[data-lp-notes]');
    const host = root.dataset.host || '';
    // Keep the floating player out of any transformed parent, so it pins to the screen itself.
    const wrap = document.createElement('div'); wrap.className = 'lp lp-float';
    const mainEl = root.closest('main'); if (mainEl) { wrap.style.setProperty('--c', getComputedStyle(mainEl).getPropertyValue('--c')); wrap.style.setProperty('--a', getComputedStyle(mainEl).getPropertyValue('--a')); }
    document.body.appendChild(wrap); wrap.appendChild(bar);

    const store = {
      get(k: string) { try { return localStorage.getItem('lp-' + k); } catch { return null; } },
      set(k: string, v: string) { try { localStorage.setItem('lp-' + k, v); } catch { /* storage off */ } },
    };
    if (store.get('rate')) rateSel.value = store.get('rate')!;
    notesBox.checked = store.get('notes') === '1';

    const items = Array.from(document.querySelectorAll<HTMLElement>('.ht-script [data-tts]'));
    const playable = () => items.filter((el) => notesBox.checked || el.dataset.tts === 'say' || el.dataset.tts === 'card');

    // Give every speaker their own voice: a voice from the device list plus a pitch, picked the same way every time.
    let voices: SpeechSynthesisVoice[] = [];
    const loadVoices = () => {
      const all = synth.getVoices();
      const en = all.filter((v) => /^en/i.test(v.lang));
      voices = en.length ? en : all;
    };
    loadVoices();
    synth.addEventListener?.('voiceschanged', loadVoices);
    const hash = (s: string) => { let h = 0; for (const c of s) h = (h * 31 + c.charCodeAt(0)) >>> 0; return h; };
    const PITCHES = [1, 0.8, 1.25, 0.9, 1.15, 0.7, 1.35];
    const cast = new Map<string, { voice?: SpeechSynthesisVoice; pitch: number }>();
    const voiceFor = (who: string) => {
      if (!cast.has(who)) {
        const n = cast.size;
        const h = hash(who);
        cast.set(who, {
          voice: voices.length ? voices[(who === host ? 0 : h) % voices.length] : undefined,
          pitch: who === host ? 1.1 : PITCHES[(n + h) % PITCHES.length],
        });
      }
      return cast.get(who)!;
    };
    const NARRATOR = '__narrator__';

    // Long lines get cut off by some browsers, so speak a sentence or two at a time.
    const chunks = (text: string) => {
      const parts = text.match(/[^.!?]+[.!?]+["”)]*\s*|[^.!?]+$/g) || [text];
      const out: string[] = []; let cur = '';
      for (const p of parts) { if ((cur + p).length > 180 && cur) { out.push(cur.trim()); cur = ''; } cur += p; }
      if (cur.trim()) out.push(cur.trim());
      return out;
    };

    // Better voices from the wiki's voice service, when it's up. Otherwise the device voices are used.
    const ttsUrl = root.dataset.ttsUrl || '';
    const ep = root.dataset.ep || '';
    const tip = $<HTMLElement>('[data-lp-tip]');
    let api = false;
    let apiChecked = false;
    const checkApi = async () => {
      if (apiChecked || !ttsUrl || !ep) return;
      apiChecked = true;
      try {
        const r = await fetch(ttsUrl + '/health', { cache: 'no-store' });
        api = r.ok && (await r.json()).ok === true;
      } catch { api = false; }
      tip.textContent = api
        ? 'AI voices (Deepgram Aura). New lines can take a second to load. Click any line to start there.'
        : 'Voices come from your device. Click any line to start there.';
    };
    const lineUrl = (el: HTMLElement) => `${ttsUrl}?ep=${encodeURIComponent(ep)}&i=${el.dataset.i}`;
    let audio: HTMLAudioElement | null = null;
    const warm = new Map<string, HTMLAudioElement>();
    // crossOrigin makes the browser send the page's address with the request, which the voice service checks.
    const prefetch = (from: HTMLElement) => {
      if (!api) return;
      const list = playable(); const at = list.indexOf(from);
      for (const el of list.slice(at + 1, at + 3)) {
        const u = lineUrl(el);
        if (warm.has(u)) continue;
        const a = new Audio(); a.crossOrigin = 'anonymous'; a.preload = 'auto'; a.src = u; warm.set(u, a);
        if (warm.size > 6) warm.delete(warm.keys().next().value!);
      }
    };

    let index = -1;
    let playing = false;
    let token = 0;

    const mark = (el: HTMLElement | null) => {
      document.querySelectorAll('.lp-current').forEach((n) => n.classList.remove('lp-current'));
      if (!el) return;
      el.classList.add('lp-current');
      const r = el.getBoundingClientRect();
      if (r.top < 120 || r.bottom > window.innerHeight - (window.innerWidth <= 1260 ? 150 : 60)) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    const label = (el: HTMLElement) => {
      const t = el.dataset.tts;
      if (t === 'say') return `<b>${el.dataset.who || ''}</b> ${el.textContent}`;
      if (t === 'card') return `<b>${el.textContent}</b>`;
      return `<i>${el.textContent}</i>`;
    };

    const speakEl = (el: HTMLElement, myToken: number) => {
      if (api && el.dataset.i) {
        const u = lineUrl(el);
        const a = warm.get(u) || Object.assign(new Audio(), { crossOrigin: 'anonymous', src: u });
        warm.delete(u);
        audio = a;
        a.playbackRate = Number(rateSel.value);
        a.onended = () => { if (myToken === token) setTimeout(() => advance(1, myToken), el.dataset.tts === 'card' ? 350 : 150); };
        a.onerror = () => { if (myToken !== token) return; api = false; tip.textContent = 'The AI voices are resting right now, so your device voices are reading instead.'; speakDevice(el, myToken); };
        a.play().catch(() => { if (myToken === token) { api = false; speakDevice(el, myToken); } });
        prefetch(el);
        return;
      }
      speakDevice(el, myToken);
    };

    const speakDevice = (el: HTMLElement, myToken: number) => {
      const t = el.dataset.tts;
      const who = t === 'say' ? (el.dataset.who || NARRATOR) : NARRATOR;
      const v = who === NARRATOR ? { voice: voices[1 % Math.max(voices.length, 1)], pitch: 0.95 } : voiceFor(who);
      const pieces = chunks(el.textContent || '');
      let i = 0;
      const next = () => {
        if (myToken !== token) return;
        if (i >= pieces.length) { advance(1, myToken); return; }
        const u = new SpeechSynthesisUtterance(pieces[i++]);
        if (v.voice) u.voice = v.voice;
        u.pitch = v.pitch;
        u.rate = Number(rateSel.value) * (t === 'say' ? 1 : 1.05);
        u.volume = t === 'say' ? 1 : 0.85;
        u.onend = () => { if (myToken === token) setTimeout(next, t === 'card' ? 350 : 120); };
        u.onerror = (ev) => {
          if (myToken !== token || ev.error === 'interrupted' || ev.error === 'canceled') return;
          pause();
          now.textContent = 'Your browser couldn\'t play that line. Try another browser, or check that your device has a voice installed.';
        };
        synth.speak(u);
      };
      next();
    };

    const playFrom = (el: HTMLElement) => {
      token++;
      synth.cancel();
      if (audio) { audio.pause(); audio.onended = null; audio.onerror = null; audio = null; }
      const list = playable();
      index = list.indexOf(el);
      if (index < 0) return;
      playing = true;
      playBtn.textContent = '❚❚'; playBtn.setAttribute('aria-label', 'Pause');
      mark(el);
      now.innerHTML = label(el);
      speakEl(el, token);
    };

    const advance = (step: number, myToken = token) => {
      if (myToken !== token) return;
      const list = playable();
      const cur = document.querySelector<HTMLElement>('.lp-current');
      const at = cur ? list.indexOf(cur) : index;
      const nextEl = list[at + step];
      if (!nextEl) { stop(); now.textContent = 'That\'s the end of the episode.'; return; }
      playFrom(nextEl);
    };

    const pause = () => {
      token++;
      synth.cancel();
      if (audio) { audio.pause(); audio.onended = null; audio.onerror = null; audio = null; }
      playing = false;
      playBtn.textContent = '▶'; playBtn.setAttribute('aria-label', 'Play');
    };

    const stop = () => {
      pause();
      index = -1;
      mark(null);
      now.textContent = 'Press play to start.';
    };

    openBtn.addEventListener('click', () => {
      const open = bar.hidden;
      bar.hidden = !open;
      openBtn.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('lp-on', open);
      if (open) checkApi();
      if (!open) stop();
    });
    playBtn.addEventListener('click', () => {
      if (playing) { pause(); return; }
      const cur = document.querySelector<HTMLElement>('.lp-current');
      playFrom(cur && playable().includes(cur) ? cur : playable()[0]);
    });
    $('[data-lp-next]').addEventListener('click', () => advance(1));
    $('[data-lp-prev]').addEventListener('click', () => advance(-1));
    $('[data-lp-stop]').addEventListener('click', stop);
    rateSel.addEventListener('change', () => { store.set('rate', rateSel.value); if (audio) audio.playbackRate = Number(rateSel.value); const cur = document.querySelector<HTMLElement>('.lp-current'); if (playing && cur) playFrom(cur); });
    notesBox.addEventListener('change', () => store.set('notes', notesBox.checked ? '1' : '0'));
    items.forEach((el) => el.addEventListener('click', () => {
      if (!document.body.classList.contains('lp-on')) return;
      if (el.dataset.tts === 'note' && !notesBox.checked) { notesBox.checked = true; store.set('notes', '1'); }
      playFrom(el);
    }));
    window.addEventListener('pagehide', () => synth.cancel());
  }
</script>
