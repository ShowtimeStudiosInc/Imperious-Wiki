---
// A template block with a copy button. The text is passed as a prop so it keeps its Discord formatting exactly.
interface Props { title: string; text: string; note?: string }
const { title, text, note } = Astro.props;
---
<div class="not-content ia-copy">
  <div class="ia-copy-head">
    <strong>{title}</strong>
    <button type="button" class="ia-copy-btn" data-text={text}>⧉ Copy</button>
  </div>
  {note && <p class="ia-copy-note">{note}</p>}
  <pre><code>{text}</code></pre>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.ia-copy-btn').forEach((b) => {
    if (b.dataset.bound) return;
    b.dataset.bound = '1';
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.text!);
        b.textContent = '✓ Copied';
      } catch {
        b.textContent = 'Select and copy';
      }
      setTimeout(() => (b.textContent = '⧉ Copy'), 1600);
    });
  });
</script>
