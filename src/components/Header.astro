---
/**
 * Starlight header override: the same top bar as every other page on the wiki
 * (logo, name, main menu), with Starlight's search kept on the right.
 */
import Search from 'virtual:starlight/components/Search';
import { NAV, navKey } from '../lib/nav';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const link = (h: string) => base + h.replace(/^\//, '');
const here = navKey(Astro.url.pathname);
---
<div class="ia-header">
  <a class="ia-brand" href={base}><img src={link('/images/brand/logo-white.png')} alt="" width="22" height="27" /> Imperious Authorities</a>
  <nav class="ia-nav" aria-label="Main">
    {NAV.map((n) => <a href={link(n.href)} aria-current={here === n.key ? 'page' : undefined}>{n.short ? <><span class="nl-full">{n.label}</span><span class="nl-short">{n.short}</span></> : n.label}</a>)}
  </nav>
  <div class="ia-search print:hidden"><Search /></div>
</div>

<style>
  .ia-header { display: flex; align-items: center; gap: 1.25rem; height: 100%; }
  .ia-brand { font-family: 'Libre Baskerville', 'Baskerville', Georgia, serif; font-size: 1.02rem; letter-spacing: 0.04em; color: #ece6ff; display: flex; align-items: center; gap: 0.5rem; text-decoration: none; white-space: nowrap; }
  .ia-brand img { height: 1.6rem; width: auto; display: block; }
  .ia-nav { display: flex; gap: 1rem; font-size: 0.86rem; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
  .ia-nav a { color: #a99fc7; text-decoration: none; }
  .ia-nav a:hover, .ia-nav a[aria-current] { color: #ece6ff; }
  .ia-search { margin-left: auto; }
  @media (max-width: 62rem) { .ia-nav { display: none; } }
</style>
