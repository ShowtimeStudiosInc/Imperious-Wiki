---
/**
 * The Homeworld Times mark: the Throne of Homeworld standing on the planet's horizon, broadcasting
 * from its spire, inside the network's siren ring (the bright sweep that runs around it on air).
 */
interface Props { size?: number }
const { size = 64 } = Astro.props;
const id = `ht${Math.random().toString(36).slice(2, 8)}`;
---
<svg class="ht-logo" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2a0f18" />
      <stop offset="1" stop-color="#4a1420" />
    </linearGradient>
    <clipPath id={`${id}-in`}><circle cx="32" cy="32" r="24.5" /></clipPath>
  </defs>
  <!-- the dial: sky, horizon, Throne -->
  <circle cx="32" cy="32" r="24.5" fill={`url(#${id}-sky)`} />
  <g clip-path={`url(#${id}-in)`}>
    <path d="M2 50 Q32 36 62 50 V64 H2 Z" fill="#120a10" />
    <path d="M2 50 Q32 36 62 50" fill="none" stroke="#f3ece0" stroke-opacity=".75" stroke-width="1.2" />
    <polygon points="29.6,44 32,21 34.4,44" fill="#f3ece0" />
    <polygon points="24.4,45.5 26.4,32 28.4,45" fill="#f3ece0" fill-opacity=".8" />
    <polygon points="35.6,45 37.6,32 39.6,45.5" fill="#f3ece0" fill-opacity=".8" />
    <!-- the broadcast from the spire: a flare with two rings going out -->
    <circle cx="32" cy="21" r="8" fill="none" stroke="#ff3d4f" stroke-opacity=".7" stroke-width="1" stroke-dasharray="2.4 2" />
    <path d="M32 15.2 L33 20 L37.8 21 L33 22 L32 26.8 L31 22 L26.2 21 L31 20 Z" fill="#ffd27a" />
  </g>
  <!-- the siren ring -->
  <circle cx="32" cy="32" r="28.5" fill="none" stroke="#f3ece0" stroke-opacity=".08" stroke-width="2.4" />
  <path d="M56.68 17.75 A28.5 28.5 0 0 1 60.39 29.52" fill="none" stroke="#ff3d4f" stroke-opacity="0.29" stroke-width="3.2" stroke-linecap="butt" />
  <path d="M60.39 29.52 A28.5 28.5 0 0 1 58.78 41.75" fill="none" stroke="#ff3d4f" stroke-opacity="0.34" stroke-width="3.2" stroke-linecap="butt" />
  <path d="M58.78 41.75 A28.5 28.5 0 0 1 52.15 52.15" fill="none" stroke="#ff3d4f" stroke-opacity="0.41" stroke-width="3.2" stroke-linecap="butt" />
  <path d="M52.15 52.15 A28.5 28.5 0 0 1 41.75 58.78" fill="none" stroke="#ff3d4f" stroke-opacity="0.48" stroke-width="3.2" stroke-linecap="butt" />
  <path d="M41.75 58.78 A28.5 28.5 0 0 1 29.52 60.39" fill="none" stroke="#ff3d4f" stroke-opacity="0.54" stroke-width="3.2" stroke-linecap="butt" />
  <path d="M29.52 60.39 A28.5 28.5 0 0 1 17.75 56.68" fill="none" stroke="#ff3d4f" stroke-opacity="0.61" stroke-width="3.2" stroke-linecap="butt" />
  <path d="M17.75 56.68 A28.5 28.5 0 0 1 8.65 48.35" fill="none" stroke="#ff3d4f" stroke-opacity="0.68" stroke-width="3.2" stroke-linecap="butt" />
  <path d="M8.65 48.35 A28.5 28.5 0 0 1 3.93 36.95" fill="none" stroke="#ff5656" stroke-opacity="0.74" stroke-width="3.2" stroke-linecap="butt" />
  <path d="M3.93 36.95 A28.5 28.5 0 0 1 4.47 24.62" fill="none" stroke="#ff755f" stroke-opacity="0.80" stroke-width="3.2" stroke-linecap="butt" />
  <path d="M4.47 24.62 A28.5 28.5 0 0 1 10.17 13.68" fill="none" stroke="#ff9468" stroke-opacity="0.87" stroke-width="3.2" stroke-linecap="butt" />
  <path d="M10.17 13.68 A28.5 28.5 0 0 1 19.96 6.17" fill="none" stroke="#ffb371" stroke-opacity="0.94" stroke-width="3.2" stroke-linecap="butt" />
  <path d="M19.96 6.17 A28.5 28.5 0 0 1 32.00 3.50" fill="none" stroke="#ffd27a" stroke-opacity="1.00" stroke-width="3.2" stroke-linecap="butt" />
  <circle cx="32" cy="3.5" r="2.6" fill="#ffd27a" />
  <circle cx="32" cy="32" r="24.5" fill="none" stroke="#f3ece0" stroke-opacity=".35" stroke-width=".8" />
</svg>
