---
/** The Homeworld Times mark: a broadcast ring with a hot sweep around a small diamond. */
interface Props { size?: number }
const { size = 64 } = Astro.props;
---
<svg class="ht-logo" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <linearGradient id="ht-sweep" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffd27a" />
      <stop offset=".55" stop-color="#ff3d4f" />
      <stop offset="1" stop-color="#ff3d4f" stop-opacity="0" />
    </linearGradient>
  </defs>
  <circle cx="32" cy="32" r="27" fill="none" stroke="#f3ece0" stroke-opacity=".22" stroke-width="3" />
  <path d="M32 5 A27 27 0 0 1 59 32" fill="none" stroke="url(#ht-sweep)" stroke-width="4" stroke-linecap="round" />
  <circle cx="32" cy="32" r="19" fill="none" stroke="#f3ece0" stroke-opacity=".5" stroke-width="1.2" stroke-dasharray="2 3" />
  <polygon points="32,20 41,30 32,45 23,30" fill="#ff3d4f" />
  <polygon points="32,20 36,30 32,45 28,30" fill="#ffd27a" fill-opacity=".55" />
  <line x1="23" y1="30" x2="41" y2="30" stroke="#120b10" stroke-width="1.2" />
</svg>
